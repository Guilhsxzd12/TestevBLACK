<section id="{{ section.settings.anchor | default: 'paises' | escape }}" class="vm-origins vm-container" data-horizontal-carousel><div class="vm-section-heading"><h2>{{ section.settings.title | escape }}</h2><div class="vm-inline-controls"><button type="button" data-row-prev aria-label="Países anteriores">‹</button><button type="button" data-row-next aria-label="Próximos países">›</button></div></div><div class="vm-origins-track" data-row-track tabindex="0" aria-label="Países de origem">{% for block in section.blocks %}<a href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.all_products_collection_url }}?view=descobrir&amp;pais={{ block.settings.title | url_encode }}{% endif %}" {{ block.shopify_attributes }}>{% if block.settings.flag %}{{ block.settings.flag | image_url: width: 480 | image_tag: class: 'vm-custom-flag', loading: 'lazy', alt: block.settings.title }}{% else %}{% render 'country-flag', country: block.settings.title %}{% endif %}<strong>{{ block.settings.title | escape }}</strong></a>{% endfor %}</div></section>
{% schema %}{"name": "Videira · Países", "settings": [{"type": "text", "id": "title", "label": "Título", "default": "Países e regiões"}, {"type": "text", "id": "anchor", "label": "Identificador do link", "default": "paises"}], "presets": [{"name": "Videira · Países", "blocks": [{"type": "country", "settings": {"title": "Argentina"}}, {"type": "country", "settings": {"title": "Chile"}}, {"type": "country", "settings": {"title": "Brasil"}}]}], "blocks": [{"type": "country", "name": "País", "settings": [{"type": "text", "id": "title", "label": "Nome", "default": "Portugal"}, {"type": "image_picker", "id": "flag", "label": "Bandeira personalizada"}, {"type": "url", "id": "link", "label": "Destino personalizado"}]}]}{% endschema %}
