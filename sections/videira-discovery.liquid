<section class="vm-discovery vm-container" data-discovery data-catalog-url="{{ routes.all_products_collection_url }}"><nav class="sf-breadcrumb"><a href="{{ routes.root_url }}">Início</a><span>/</span><a href="{{ routes.all_products_collection_url }}">Vinhos</a><span>/</span><span data-discovery-breadcrumb>Descobertas</span></nav><h1 data-discovery-title>Encontre seu próximo vinho</h1><p class="vm-discovery-intro" data-discovery-intro>Explore por:</p>
<div data-critic-directory><div class="vm-score-ranges"><a href="{{ collection.url }}?view=descobrir&amp;modo=pontuacoes&amp;nota=90-94">90 a 94 pontos</a><a href="{{ collection.url }}?view=descobrir&amp;modo=pontuacoes&amp;nota=95-100">95 a 100 pontos</a><a href="{{ collection.url }}?view=descobrir&amp;modo=pontuacoes&amp;nota=todas">Todos os pontuados</a></div><div class="vm-critic-grid">{% assign critic_names = 'Robert Parker,Wine Spectator,James Suckling,Guia Descorchados,Decanter,Wine Enthusiast,Jancis Robinson,Gambero Rosso,Tim Atkin,Antonio Galloni,Burghound,Wine and Spirits' | split: ',' %}{% assign critic_files = 'robert-parker,wine-spectator,james-suckling,descorchados,decanter,wine-enthusiast,jancis,gambero-rosso,tim-atkin,antonio-galloni,burghound,wine-spirits' | split: ',' %}{% for name in critic_names %}{% assign logo_file = 'critic-' | append: critic_files[forloop.index0] | append: '-critico.png' %}<a href="{{ collection.url }}?view=descobrir&amp;modo=pontuacoes&amp;critico={{ name | url_encode }}" data-critic-link="{{ name | escape }}"><div><img src="{{ logo_file | asset_url }}" alt="{{ name | escape }}" width="240" height="180" loading="lazy"></div><span>{{ name }}</span></a>{% endfor %}</div><div class="vm-extra-critics" data-extra-critics></div></div>
<form class="vm-discovery-filters" action="{{ collection.url }}" method="get" data-discovery-filters hidden><input type="hidden" name="view" value="descobrir"><input type="hidden" name="modo" value="pontuacoes"><label>Crítico ou revista<select name="critico" data-critic-select><option value="">Todos</option>{% for name in critic_names %}<option>{{ name }}</option>{% endfor %}</select></label><label>Pontuação<select name="nota"><option value="">Todas</option><option value="90-94">90 a 94 pontos</option><option value="95-100">95 a 100 pontos</option><option value="90-100">90 pontos ou mais</option><option value="0-89">Até 89 pontos</option></select></label><label class="vm-discovery-available"><input type="checkbox" name="disponivel" value="1"> Apenas disponíveis</label><button type="submit">Filtrar</button><a href="{{ collection.url }}?view=descobrir&amp;modo=pontuacoes">Ver todos os críticos</a></form>
<div class="vm-pairing-filter-links" data-pairing-links hidden><a href="{{ collection.url }}?view=descobrir&amp;harmonizacao=pizzas">Pizzas</a><a href="{{ collection.url }}?view=descobrir&amp;harmonizacao=carnes-vermelhas">Carnes vermelhas</a><a href="{{ collection.url }}?view=descobrir&amp;harmonizacao=queijos">Queijos</a><a href="{{ collection.url }}?view=descobrir&amp;harmonizacao=massas">Massas</a><a href="{{ routes.root_url }}#harmonizacoes">Todas as harmonizações</a></div>
<p class="vm-discovery-status" role="status" aria-live="polite" data-discovery-status>Consultando os dados dos vinhos…</p><button type="button" data-discovery-retry hidden>Tentar novamente</button><div class="sf-catalog-grid vm-discovery-results" data-discovery-results></div><button type="button" class="mi-outline vm-discovery-more" data-discovery-more hidden>Mostrar mais vinhos</button><noscript><p>Ative o JavaScript para filtrar os dados de harmonização e premiação. Você também pode <a href="{{ routes.all_products_collection_url }}">explorar todos os vinhos</a>.</p></noscript>
{% paginate collection.products by 48 %}<div data-discovery-batch data-next="{{ paginate.next.url }}" hidden>{% for product in collection.products %}{% capture pairing %}{% render 'product-fact', product: product, field: 'pairing' %}{% endcapture %}<template data-discovery-card data-id="{{ product.id }}" data-pairing="{{ pairing | strip | escape }}" data-price="{{ product.price }}" data-available="{{ product.available }}">{% render 'product-card', product: product %}</template>{% endfor %}</div>{% endpaginate %}
</section>
{% schema %}{"name":"Videira · Descobertas","settings":[]}{% endschema %}
