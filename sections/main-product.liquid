{% assign variant = product.selected_or_first_available_variant %}
<section class="sf-section pd-product"><nav class="pd-breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><a href="{{ routes.all_products_collection_url }}">{{ 'general.store' | t }}</a><span>/</span><span aria-current="page">{{ product.title | escape }}</span></nav>
<div class="pd-grid"><div class="pd-gallery">{% render 'product-awards', product: product %}<button class="pd-photo-button" type="button" data-product-zoom {% unless product.featured_image %}disabled{% endunless %} aria-label="{{ 'product.zoom' | t }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: class: 'pd-original-photo', fetchpriority: 'high', widths: '400,700,1000,1400', sizes: '(max-width: 760px) 90vw, 45vw', alt: product.title }}<span class="pd-zoom-hint">{{ 'product.zoom' | t }} +</span>{% else %}<span class="pd-photo-missing">{% render 'icon', name: 'glass' %}{{ 'product.no_image' | t }}</span>{% endif %}</button>
{% if product.images.size > 1 %}<div class="pd-thumbnails">{% for image in product.images %}<button type="button" data-product-image="{{ image | image_url: width: 1400 }}" aria-label="{{ image.alt | default: product.title | escape }}">{{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: image.alt }}</button>{% endfor %}</div>{% endif %}</div>
{% capture product_country %}{% render 'product-fact', product: product, field: 'country' %}{% endcapture %}{% assign product_country = product_country | strip %}
{% capture product_region %}{% render 'product-fact', product: product, field: 'region' %}{% endcapture %}{% assign product_region = product_region | strip %}
{% capture product_grapes %}{% render 'product-fact', product: product, field: 'grape' %}{% endcapture %}{% assign product_grapes = product_grapes | strip %}
{% capture product_volume %}{% render 'product-fact', product: product, field: 'volume' %}{% endcapture %}{% assign product_volume = product_volume | strip %}
<div class="pd-summary"><h1>{{ product.title | escape }}</h1>{% if variant.sku != blank %}<p class="pd-product-code">Código {{ variant.sku | escape }}</p>{% endif %}
<div class="pd-identity">
{% if product.vendor != blank %}<div class="pd-identity-row">{% render 'product-identity-icon', name: 'producer' %}<div><h2>PRODUTOR</h2><a class="pd-winery" href="{{ product.vendor | url_for_vendor }}">{{ product.vendor | escape }}</a></div></div>{% endif %}
{% if product_country != blank or product_region != blank %}<div class="pd-identity-row pd-location">{% render 'product-identity-icon', name: 'country' %}<div><h2>ORIGEM</h2><p>{% if product_country != blank %}{{ product_country }}{% endif %}{% if product_country != blank and product_region != blank %}, {% endif %}{{ product_region }}</p></div></div>{% endif %}
{% if product_grapes != blank %}<div class="pd-identity-row">{% render 'product-identity-icon', name: 'grape' %}<div><h2>UVAS</h2><p>{{ product_grapes }}</p></div></div>{% endif %}
</div>{% if product_volume != blank %}<div class="pd-volume">{% render 'product-identity-icon', name: 'volume' %}<span>{{ product_volume }}</span></div>{% endif %}
{% form 'product', product, id: 'videira-product-form', data-shopify-add: '' %}<input type="hidden" name="return_to" value="{{ routes.cart_url }}">{{ form.errors | default_errors }}
{% unless product.has_only_default_variant %}<label class="pd-variant-label" for="variant-select">{{ 'product.variant' | t }}</label><select class="pd-variant" id="variant-select" name="id">{% for option in product.variants %}<option value="{{ option.id }}" {% if option.id == variant.id %}selected{% endif %}>{{ option.title | escape }}{% unless option.available %} — {{ 'product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ variant.id }}">{% endunless %}
<div class="pd-purchase-dock"><div class="pd-price"><del data-product-compare {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ variant.compare_at_price | money }}</del><strong data-product-price>{{ variant.price | money }}</strong></div>
<div class="pd-purchase"><div class="vm-quantity pd-quantity"><button type="button" data-quantity-step="-1" aria-label="Diminuir quantidade">−</button><input id="product-quantity" aria-label="Quantidade" name="quantity" type="number" min="{{ variant.quantity_rule.min | default: 1 }}" step="{{ variant.quantity_rule.increment | default: 1 }}" {% if variant.quantity_rule.max %}max="{{ variant.quantity_rule.max }}"{% endif %} value="{{ variant.quantity_rule.min | default: 1 }}"><button type="button" data-quantity-step="1" aria-label="Aumentar quantidade">+</button></div><button class="sf-button" type="submit" data-product-submit data-product-buy-label="COMPRAR AGORA" {% unless variant.available %}disabled{% endunless %}><span data-product-button-label>{% if variant.available %}COMPRAR AGORA{% else %}{{ 'product.sold_out' | t }}{% endif %}</span></button></div><p class="pd-shipping-note">{{ 'product.delivery' | t }}</p></div><p class="pd-added" data-add-status role="status"></p>{% endform %}
<script type="application/json" data-product-variants>[{% for v in product.variants %}{"id":{{ v.id | json }},"available":{{ v.available | json }},"price":{{ v.price | money | json }},"compare":{{ v.compare_at_price | money | json }},"on_sale":{% if v.compare_at_price > v.price %}true{% else %}false{% endif %},"image":{% if v.featured_image %}{{ v.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %},"min":{{ v.quantity_rule.min | default: 1 }},"step":{{ v.quantity_rule.increment | default: 1 }},"max":{{ v.quantity_rule.max | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script></div></div>
<div class="pd-information pd-compact-information">{% if product.description != blank %}<section class="pd-description"><h2>{{ 'product.about' | t }}</h2><div class="rte">{{ product.description }}</div></section>{% endif %}
<details class="pd-detail-panel pd-technical-panel"><summary>FICHA TÉCNICA</summary><div class="pd-technical-list">{% assign tech_keys = 'alcohol,aging,grape,pairing,aromas,palate,visual' | split: ',' %}{% assign tech_labels = 'Grau alcoólico,Amadurecimento,Uvas,Harmonização,Aromas,Paladar,Visual' | split: ',' %}{% for key in tech_keys %}{% capture technical_value %}{% render 'product-fact', product: product, field: key %}{% endcapture %}{% assign technical_value = technical_value | strip %}{% if technical_value != blank %}<div class="pd-technical-row">{% render 'technical-icon', name: key %}<div><h3>{{ tech_labels[forloop.index0] }}</h3><p>{{ technical_value }}</p></div></div>{% endif %}{% endfor %}</div></details></div>
{% if product.featured_image %}<dialog class="pd-zoom" data-zoom-dialog aria-label="{{ 'product.zoom' | t }}"><button class="pd-zoom-close" type="button" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>{{ product.featured_image | image_url: width: 1800 | image_tag: class: 'pd-original-photo', loading: 'lazy', alt: product.title }}</dialog>{% endif %}
<script type="application/ld+json">{{ product | structured_data }}</script></section>
{% assign source = collection | default: collections.all %}{% capture related_cards %}{% assign shown = 0 %}{% for related in source.products %}{% unless related.id == product.id %}{% render 'product-card', product: related %}{% assign shown = shown | plus: 1 %}{% if shown == 8 %}{% break %}{% endif %}{% endunless %}{% endfor %}{% endcapture %}{% assign related_cards = related_cards | strip %}{% if related_cards != blank %}<section class="wc-section"><div class="wc-heading"><h2>{{ 'product.related' | t }}</h2></div><div class="wc-viewport"><div class="wc-track"><div class="wc-group">{{ related_cards }}</div></div></div></section>{% endif %}
{% schema %}
{"name": "Produto Videira", "settings": []}
{% endschema %}

