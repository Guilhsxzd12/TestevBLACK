<section id="{{ section.settings.anchor | default: 'monte-sua-caixa' | escape }}" class="mi-hero" data-banner-slider data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}"><h1 class="vm-sr-only">{{ section.settings.page_heading | escape }}</h1><div class="mi-hero-stage">{% for block in section.blocks %}<div data-banner-slide{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>{% if block.settings.style != 'arrivals' %}<a class="vm-case-banner" href="{{ block.settings.link | default: routes.all_products_collection_url }}"><div class="vm-case-copy"><p class="vm-case-eyebrow">{{ block.settings.eyebrow | default: 'SEUS VINHOS, SUA ESCOLHA' | escape }}</p><h2>{{ block.settings.headline | default: 'Monte sua caixa' | escape }}</h2><p class="vm-case-offer"><strong>{{ block.settings.offer | default: '5% OFF' | escape }}</strong><span>{{ block.settings.payment | default: 'no pagamento via Pix' | escape }}</span></p><p class="vm-case-conditions">{{ block.settings.conditions | default: 'Escolha 6 garrafas ou mais e aproveite.' | escape }}</p><span class="vm-case-cta">{{ block.settings.button_label | default: 'Montar minha caixa' | escape }}{% render 'icon', name: 'arrow' %}</span><small>{{ block.settings.note | default: 'Desconto aplicado no checkout.' | escape }}</small></div><div class="vm-case-visual">{% if block.settings.image %}<picture>{% if block.settings.mobile_image %}<source media="(max-width:760px)" srcset="{{ block.settings.mobile_image | image_url: width: 1000 }}">{% endif %}{{ block.settings.image | image_url: width: 1600 | image_tag: alt: block.settings.title, loading: 'eager' }}</picture>{% else %}{% if block.settings.mobile_image %}<picture class="vm-case-mobile-custom">{{ block.settings.mobile_image | image_url: width: 1000 | image_tag: alt: block.settings.title, loading: 'eager' }}</picture>{% endif %}<svg class="vm-case-default-scene" viewBox="0 0 768 512" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Caixa de vinhos da Videira com garrafas ao lado"><defs><clipPath id="vm-case-photo-{{ section.id }}-{{ block.id }}"><rect width="768" height="512"/></clipPath></defs><image clip-path="url(#vm-case-photo-{{ section.id }}-{{ block.id }})" href="{{ 'videira-caixa-occasions.webp' | asset_url }}" width="1536" height="1024"/></svg>{% endif %}</div></a>{% else %}<a class="vm-arrivals-banner" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.root_url }}#novidades{% endif %}"><picture><source media="(max-width:760px)" srcset="{% if block.settings.mobile_image %}{{ block.settings.mobile_image | image_url: width: 1200 }}{% elsif block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ 'videira-arrivals-mobile.webp' | asset_url }}{% endif %}">{% if block.settings.image %}{{ block.settings.image | image_url: width: 2400 | image_tag: alt: block.settings.title, loading: 'eager' }}{% else %}<img src="{{ 'videira-arrivals-desktop.webp' | asset_url }}" alt="{{ block.settings.title | escape }}" width="2048" height="768" loading="lazy">{% endif %}</picture></a>{% endif %}</div>{% endfor %}</div><div class="mi-banner-dots">{% for block in section.blocks %}<button type="button" data-banner-dot="{{ forloop.index0 }}" aria-label="Mostrar banner {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div></section>
{% schema %}{"name": "Videira · Banners", "settings": [{"type": "text", "id": "page_heading", "label": "Título da página", "default": "Videira Vinhoteca — a sua seleção de vinhos"}, {"type": "text", "id": "anchor", "label": "Identificador do link", "default": "monte-sua-caixa"}, {"type": "checkbox", "id": "autoplay", "label": "Alternar automaticamente", "default": true}, {"type": "range", "id": "interval", "label": "Intervalo em segundos", "min": 3, "max": 10, "step": 1, "default": 5}], "presets": [{"name": "Videira · Banners", "blocks": [{"type": "banner", "settings": {"style": "boxes"}}, {"type": "banner", "settings": {"style": "arrivals"}}]}], "blocks": [{"type": "banner", "name": "Banner", "settings": [{"type": "text", "id": "title", "label": "Descrição da imagem", "default": "Banner Videira"}, {"type": "select", "id": "style", "label": "Arte padrão", "default": "boxes", "options": [{"value": "boxes", "label": "Monte sua caixa"}, {"value": "arrivals", "label": "Acabou de chegar"}]}, {"type": "image_picker", "id": "image", "label": "Imagem para computador"}, {"type": "image_picker", "id": "mobile_image", "label": "Imagem para celular"}, {"type": "url", "id": "link", "label": "Destino"}, {"type": "text", "id": "eyebrow", "label": "Chamada da oferta", "default": "SEUS VINHOS, SUA ESCOLHA"}, {"type": "text", "id": "headline", "label": "Título da oferta", "default": "Monte sua caixa"}, {"type": "text", "id": "offer", "label": "Desconto anunciado", "default": "5% OFF"}, {"type": "text", "id": "payment", "label": "Forma de pagamento", "default": "no pagamento via Pix"}, {"type": "text", "id": "conditions", "label": "Condição da oferta", "default": "Escolha 6 garrafas ou mais e aproveite."}, {"type": "text", "id": "button_label", "label": "Texto do botão", "default": "Montar minha caixa"}, {"type": "text", "id": "note", "label": "Nota da oferta", "default": "Desconto aplicado no checkout."}]}], "limit": 1}{% endschema %}
