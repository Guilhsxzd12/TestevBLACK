<section id="{{ section.settings.anchor | default: 'monte-sua-caixa' | escape }}" class="mi-hero vm-campaigns" style="--campaign-height:{{ section.settings.desktop_height | default: 360 }}px;--campaign-mobile-height:{{ section.settings.mobile_height | default: 280 }}px" data-banner-slider data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}">
<h1 class="vm-sr-only">{{ section.settings.page_heading | escape }}</h1>
<div class="mi-hero-stage vm-campaign-stage">
{% for block in section.blocks %}
{% liquid
 assign campaign_style = block.settings.style | default: 'boxes'
 assign campaign_class = 'vm-case-banner'
 assign campaign_file = 'caixa'
 assign campaign_alt = 'Caixa de vinhos Videira com a marca gravada na madeira e garrafas ao lado'
 assign campaign_eyebrow = 'SEUS VINHOS, SUA ESCOLHA'
 assign campaign_headline = 'Monte sua caixa'
 assign campaign_text = 'Escolha 6 garrafas ou mais.'
 assign campaign_cta = 'Montar minha caixa'
 capture campaign_link
  echo routes.all_products_collection_url
 endcapture
 if campaign_style == 'arrivals'
  assign campaign_class = 'vm-arrivals-banner'
  assign campaign_file = 'chegou'
  assign campaign_alt = 'Caixa de madeira Videira com a marca alinhada à frente da caixa'
  assign campaign_eyebrow = 'NOVIDADES NA VIDEIRA'
  assign campaign_headline = 'Acabou de chegar'
  assign campaign_text = 'Novos rótulos para descobrir.'
  assign campaign_cta = 'Conhecer novidades'
  capture campaign_link
   echo routes.all_products_collection_url
   echo '?sort_by=created-descending'
  endcapture
 elsif campaign_style == 'festive'
  assign campaign_class = 'vm-festive-banner'
  assign campaign_file = 'fim-de-ano'
  assign campaign_alt = 'Taças de espumante e luzes douradas em uma celebração de final de ano'
  assign campaign_eyebrow = 'BRINDE AOS BONS MOMENTOS'
  assign campaign_headline = 'Um brinde ao final de ano'
  assign campaign_text = 'Espumantes e frisantes para celebrar.'
  assign campaign_cta = 'Escolher meu brinde'
  capture campaign_link
   echo routes.all_products_collection_url
   echo '?view=descobrir&tipo=Espumante&tipo=Frisante'
  endcapture
 endif
 assign campaign_headline = block.settings.headline | default: campaign_headline
 assign campaign_eyebrow = block.settings.eyebrow | default: campaign_eyebrow
 assign campaign_text = block.settings.description | default: campaign_text
 assign campaign_cta = block.settings.button_label | default: campaign_cta
 assign campaign_link = block.settings.link | default: campaign_link | strip
 assign photo_desktop = 'videira-campanha-' | append: campaign_file | append: '-desktop.webp'
 assign photo_mobile = 'videira-campanha-' | append: campaign_file | append: '-mobile.webp'
%}
<div data-banner-slide{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
<a class="vm-campaign vm-campaign--{{ campaign_style }} {{ campaign_class }}" href="{{ campaign_link | escape }}">
<picture class="vm-campaign-photo"><source media="(max-width:760px)" srcset="{% if block.settings.mobile_image %}{{ block.settings.mobile_image | image_url: width: 1000 }}{% elsif block.settings.image %}{{ block.settings.image | image_url: width: 1000 }}{% else %}{{ photo_mobile | asset_url }}{% endif %}">
{% if block.settings.image %}{{ block.settings.image | image_url: width: 1800 | image_tag: alt: block.settings.title, loading: 'eager' }}{% else %}<img src="{{ photo_desktop | asset_url }}" alt="{{ block.settings.title | default: campaign_alt | escape }}" width="1536" height="1024" {% if forloop.first %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}>{% endif %}</picture>
<div class="vm-campaign-copy"><p class="vm-campaign-eyebrow">{{ campaign_eyebrow | escape }}</p><h2>{{ campaign_headline | escape }}</h2>
{% if campaign_style == 'boxes' %}<p class="vm-campaign-offer"><strong>{{ block.settings.offer | default: '5% OFF' | escape }}</strong><span>{{ block.settings.payment | default: 'pagando no Pix ou crédito à vista' | escape }}</span></p><p class="vm-campaign-description">{{ block.settings.conditions | default: campaign_text | escape }}</p>{% else %}<p class="vm-campaign-description">{{ campaign_text | escape }}</p>{% endif %}
<span class="vm-campaign-cta">{{ campaign_cta | escape }}{% render 'icon', name: 'arrow' %}</span>
{% if campaign_style == 'boxes' %}<small>{{ block.settings.note | default: 'Confira as condições no checkout.' | escape }}</small>{% endif %}
</div></a></div>
{% endfor %}
</div>
<div class="mi-banner-dots">{% for block in section.blocks %}<button type="button" data-banner-dot="{{ forloop.index0 }}" aria-label="Mostrar banner {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div>
</section>
{% schema %}
{
  "name": "Videira · Banners",
  "settings": [
    {
      "type": "text",
      "id": "page_heading",
      "label": "Título da página",
      "default": "Videira Vinhoteca — a sua seleção de vinhos"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Identificador do link",
      "default": "monte-sua-caixa"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Alternar automaticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Intervalo em segundos",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Altura no computador",
      "min": 260,
      "max": 440,
      "step": 20,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Altura no celular",
      "min": 240,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 280
    }
  ],
  "presets": [
    {
      "name": "Videira · Banners",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "style": "boxes"
          }
        },
        {
          "type": "banner",
          "settings": {
            "style": "arrivals"
          }
        },
        {
          "type": "banner",
          "settings": {
            "style": "festive"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Descrição da imagem",
          "default": "Banner Videira"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Arte padrão",
          "default": "boxes",
          "options": [
            {
              "value": "boxes",
              "label": "Monte sua caixa"
            },
            {
              "value": "arrivals",
              "label": "Acabou de chegar"
            },
            {
              "value": "festive",
              "label": "Final de ano — espumantes e frisantes"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fotografia para computador"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Fotografia para celular"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destino"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Chamada da oferta"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Título da oferta"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descrição da campanha"
        },
        {
          "type": "text",
          "id": "offer",
          "label": "Desconto anunciado",
          "default": "5% OFF"
        },
        {
          "type": "text",
          "id": "payment",
          "label": "Forma de pagamento",
          "default": "pagando no Pix ou crédito à vista"
        },
        {
          "type": "text",
          "id": "conditions",
          "label": "Condição da oferta",
          "default": "Escolha 6 garrafas ou mais."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Nota da oferta",
          "default": "Confira os valores e as condições no checkout."
        }
      ]
    }
  ],
  "limit": 1
}
{% endschema %}
