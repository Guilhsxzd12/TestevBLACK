<section id="{{ section.settings.anchor | default: 'black-friday' | escape }}" class="mi-hero" data-banner-slider data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}"><h1 class="vm-sr-only">{{ section.settings.page_heading | escape }}</h1><div class="mi-hero-stage">{% for block in section.blocks %}{% assign fallback_desktop = 'mistral-hero-desktop.jpg' %}{% assign fallback_mobile = 'videira-banner-mobile.webp' %}{% if block.settings.style == 'arrivals' %}{% assign fallback_desktop = 'videira-arrivals-desktop.webp' %}{% assign fallback_mobile = 'videira-arrivals-mobile.webp' %}{% endif %}<div data-banner-slide{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}><a{% if block.settings.style == 'arrivals' %} class="vm-arrivals-banner"{% endif %} href="{% if block.settings.link != blank %}{{ block.settings.link }}{% elsif block.settings.style == 'arrivals' %}{{ routes.root_url }}#novidades{% else %}{{ routes.all_products_collection_url }}{% endif %}"><picture><source media="(max-width:760px)" srcset="{% if block.settings.mobile_image %}{{ block.settings.mobile_image | image_url: width: 1200 }}{% elsif block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ fallback_mobile | asset_url }}{% endif %}">{% if block.settings.image %}{{ block.settings.image | image_url: width: 2400 | image_tag: alt: block.settings.title, loading: 'eager' }}{% else %}<img src="{{ fallback_desktop | asset_url }}" alt="{{ block.settings.title | escape }}" width="2048" height="768" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>{% endif %}</picture></a></div>{% endfor %}</div><div class="mi-banner-dots">{% for block in section.blocks %}<button type="button" data-banner-dot="{{ forloop.index0 }}" aria-label="Mostrar banner {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div></section>
{% schema %}{"name": "Videira · Banners", "settings": [{"type": "text", "id": "page_heading", "label": "Título da página", "default": "Videira Vinhoteca — a sua seleção de vinhos"}, {"type": "text", "id": "anchor", "label": "Identificador do link", "default": "black-friday"}, {"type": "checkbox", "id": "autoplay", "label": "Alternar automaticamente", "default": true}, {"type": "range", "id": "interval", "label": "Intervalo em segundos", "min": 3, "max": 10, "step": 1, "default": 5}], "presets": [{"name": "Videira · Banners", "blocks": [{"type": "banner", "settings": {"style": "black"}}, {"type": "banner", "settings": {"style": "arrivals"}}]}], "blocks": [{"type": "banner", "name": "Banner", "settings": [{"type": "text", "id": "title", "label": "Descrição da imagem", "default": "Banner Videira"}, {"type": "select", "id": "style", "label": "Arte padrão", "default": "black", "options": [{"value": "black", "label": "Black Videira"}, {"value": "arrivals", "label": "Acabou de chegar"}]}, {"type": "image_picker", "id": "image", "label": "Imagem para computador"}, {"type": "image_picker", "id": "mobile_image", "label": "Imagem para celular"}, {"type": "url", "id": "link", "label": "Destino"}]}], "limit": 1}{% endschema %}
