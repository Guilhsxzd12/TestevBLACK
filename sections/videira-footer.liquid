<footer id="videira-contact" class="vm-footer"><div class="vm-container vm-footer-layout"><div class="vm-footer-brand"><a class="vm-logo" href="{{ routes.root_url }}" aria-label="Videira Vinhoteca — início">{% render 'logo' %}</a><p class="vm-footer-signature">{{ section.settings.signature | escape }}<br>{{ section.settings.signature_second | escape }}</p><small class="vm-footer-description">{{ section.settings.description | escape | newline_to_br }}</small><div class="vm-footer-social"><a href="https://www.instagram.com/videiravinhoteca/" target="_blank" rel="noopener" aria-label="Instagram da Videira">{% render 'social-icon', name: 'instagram' %}</a>{% if settings.whatsapp != blank %}<a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener" aria-label="WhatsApp da Videira">{% render 'social-icon', name: 'whatsapp' %}</a>{% endif %}</div></div><div class="vm-footer-links"><details data-footer-group open><summary>INSTITUCIONAL</summary><div><a href="{{ routes.all_products_collection_url }}?view=informacoes">A Videira</a>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}{% for link in section.settings.footer_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div></details><details data-footer-group open><summary>ATENDIMENTO</summary><div>{% if settings.whatsapp != blank %}<a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">Fale pelo WhatsApp</a>{% endif %}<a href="https://www.instagram.com/videiravinhoteca/" target="_blank" rel="noopener">@videiravinhoteca</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Minha conta e pedidos</a>{% endif %}<a href="{{ routes.cart_url }}">Meu carrinho</a><span>Foz do Iguaçu – PR · Loja online</span><span>Venda exclusivamente online, sem loja física.</span></div></details><details data-footer-group open><summary>FORMAS DE PAGAMENTO</summary><div>{% if shop.enabled_payment_types.size > 0 %}<div class="vm-payment-icons">{% for payment_type in shop.enabled_payment_types %}{{ payment_type | payment_type_svg_tag }}{% endfor %}</div>{% else %}<p>Confira as opções disponíveis ao finalizar sua compra.</p>{% endif %}<p>Pagamento e condições apresentados no checkout.</p></div></details><details data-footer-group open><summary>COMPRA SEGURA</summary><div><p>{% render 'icon', name: 'bag' %} Checkout integrado à Shopify</p><p>{% render 'icon', name: 'chat' %} Atendimento da Videira</p><p>Frete e prazo calculados para o seu endereço no checkout.</p></div></details></div></div><div class="vm-footer-bottom">{% if settings.company_cnpj != blank %}<p>Videira Vinhoteca · CNPJ {{ settings.company_cnpj | escape }}</p>{% endif %}<p>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. Todos os direitos reservados.</p><p>Venda proibida para menores de 18 anos. Beba com moderação. Se beber, não dirija.</p></div></footer>
<div class="vm-contact-float"><a href="https://www.instagram.com/videiravinhoteca/" target="_blank" rel="noopener" aria-label="Instagram da Videira">{% render 'social-icon', name: 'instagram' %}</a>{% if settings.whatsapp != blank %}<a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener" aria-label="Atendimento no WhatsApp">{% render 'social-icon', name: 'whatsapp' %}</a>{% endif %}</div>
{% schema %}{"name": "Videira · Rodapé", "settings": [{"type": "link_list", "id": "footer_menu", "label": "Menu institucional"}, {"type": "text", "id": "signature", "label": "Assinatura — linha 1", "default": "Uma seleção de vinhos."}, {"type": "text", "id": "signature_second", "label": "Assinatura — linha 2", "default": "Um mundo para descobrir."}, {"type": "textarea", "id": "description", "label": "Texto da marca", "default": "Rótulos, origens e produtores para cada ocasião. Explore a Videira e encontre o vinho que combina com você."}]}{% endschema %}
