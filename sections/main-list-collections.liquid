<section class="sf-catalog"><div class="sf-catalog-heading"><h1>{{ 'general.collections' | t }}</h1></div><div class="sf-catalog-grid">{% for collection in collections %}{% if collection.handle != 'frontpage' and collection.products_count > 0 %}<article class="sf-wine-card"><a href="{{ collection.url }}" class="sf-wine-visual">{% assign collection_photo = collection.image | default: collection.products.first.featured_image %}{% if collection_photo %}{{ collection_photo | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}{% endif %}</a><div class="sf-wine-info"><h2><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2><p>{{ collection.products_count }} rótulos</p></div></article>{% endif %}{% endfor %}</div></section>
{% schema %}
{"name": "Coleções Videira", "settings": []}
{% endschema %}

