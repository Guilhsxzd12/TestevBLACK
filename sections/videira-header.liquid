<div class="vm-announcement-bar" data-store-announcements role="region" aria-label="Informações da Videira"><div class="vm-announcement-track"><span data-store-message>{{ section.settings.announcement_shipping | default: 'ENVIO PARA TODO O BRASIL' | escape }}</span><span data-store-message hidden>{{ section.settings.announcement_campaign | default: 'BLACK VIDEIRA · 27 A 30 DE NOVEMBRO' | escape }}</span></div></div>
<header class="zip-header vn-header vm-header"><div class="vm-header-main vm-container"><button type="button" class="vm-menu-button" data-menu-toggle aria-expanded="false" aria-controls="vn-mobile" aria-label="Abrir menu">{% render 'icon', name: 'menu' %}</button><a class="vm-logo" href="{{ routes.root_url }}" aria-label="Videira Vinhoteca — início">{% render 'logo' %}</a><form class="zip-search vm-search" action="{{ routes.search_url }}" method="get" role="search"><input type="hidden" name="type" value="product"><input type="search" name="q" placeholder="O que você procura?" value="{% render 'search-label' %}" aria-label="Pesquisar vinhos"><button type="submit" aria-label="Pesquisar">{% render 'icon', name: 'search' %}</button></form><div class="vm-header-actions"><a class="mi-support" href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">ATENDIMENTO</a>{% if shop.customer_accounts_enabled %}<a class="vm-account" href="{{ routes.account_url }}">{% render 'icon', name: 'account' %}</a>{% endif %}<button type="button" class="vm-favorites" data-wishlist-open aria-label="Meus favoritos">{% render 'icon', name: 'heart' %}</button><a class="vm-cart" href="{{ routes.cart_url }}" aria-label="Abrir carrinho">{% render 'icon', name: 'bag' %}<span data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></a></div></div>
<nav class="vm-desktop-nav" aria-label="Navegação principal"><div class="vm-container"><a href="{{ routes.all_products_collection_url }}">VER TODOS</a><details class="nv-nav-group vn-group"><summary>PAÍS E REGIÃO <span>⌄</span></summary><div class="mi-mega"><div><h2>Países</h2>{% assign countries = 'Argentina,Chile,Brasil' | split: ',' %}{% assign queries = 'vendor:"Gascón" OR vendor:"Susana Balbo" OR vendor:"Mosquita Muerta" OR vendor:"Martino" OR vendor:"Puna",vendor:"Becas",vendor:"Casa Valduga" OR vendor:"Ponto Nero"' | split: ',' %}{% for country in countries %}<a href="{{ routes.search_url }}?type=product&amp;q={{ queries[forloop.index0] | url_encode }}">{{ country }}</a>{% endfor %}<a href="{{ routes.root_url }}#paises">Ver todos os países →</a></div><div><h2>Explore por origem</h2><p>Encontre os rótulos e as bodegas que fazem parte da seleção Videira.</p><a href="{{ routes.all_products_collection_url }}">Explorar a seleção →</a></div></div></details><a href="{{ routes.root_url }}#bodegas">PRODUTORES</a><details class="nv-nav-group vn-group"><summary>TIPOS E UVAS <span>⌄</span></summary><div class="mi-mega"><div><h2>Tipos de vinho</h2>{% assign categories = 'tinto,branco,rose,espumante,frisante' | split: ',' %}{% assign labels = 'Tinto,Branco,Rosado,Espumante,Frisante' | split: ',' %}{% for category in categories %}{% capture destination %}{% render 'category-link', category: category %}{% endcapture %}<a href="{{ destination | strip }}">{{ labels[forloop.index0] }}</a>{% endfor %}</div><div><h2>Uvas</h2>{% assign grapes = 'Cabernet Sauvignon,Malbec,Chardonnay,Pinot Noir,Merlot,Carménère,Syrah,Sauvignon Blanc' | split: ',' %}{% for grape in grapes %}<a href="{{ routes.search_url }}?type=product&amp;q={{ grape | url_encode }}">{{ grape }}</a>{% endfor %}</div></div></details><a href="{{ routes.root_url }}#selecao">SELEÇÕES</a><a href="{{ routes.root_url }}#novidades">NOVIDADES</a><a href="{{ routes.all_products_collection_url }}">PRESENTES</a><details class="nv-nav-group vn-group"><summary>RECOMENDADOS <span>⌄</span></summary><div class="mi-mega"><div><h2>Recomendações</h2><a href="{{ routes.root_url }}#selecao">Escolhas da Videira</a><a href="{{ routes.root_url }}#boas-compras">Boas compras</a><a href="{{ routes.root_url }}#novidades">Novidades</a></div><div><h2>Por preço</h2><a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=100">Até R$ 100</a><a href="{{ routes.all_products_collection_url }}?filter.v.price.gte=100&amp;filter.v.price.lte=300">De R$ 100 a R$ 300</a><a href="{{ routes.all_products_collection_url }}?filter.v.price.gte=300">Acima de R$ 300</a></div></div></details><a class="vm-nav-accent" href="{{ routes.root_url }}#black-friday">BLACK FRIDAY</a></div></nav><div id="vn-mobile" class="vm-menu-shell" role="dialog" aria-modal="true" aria-label="Menu da Videira" hidden><button type="button" class="vm-menu-backdrop" data-menu-close aria-label="Fechar menu"></button><nav class="vm-menu-panel" aria-label="Menu para celular"><div class="vm-menu-welcome">{% render 'icon', name: 'account' %}<div><strong>Olá, seja bem-vindo</strong>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Entre ou cadastre-se</a>{% else %}<span>Descubra seu próximo vinho</span>{% endif %}</div><button type="button" data-menu-close aria-label="Fechar menu">{% render 'icon', name: 'close' %}</button></div><div class="vm-menu-help">{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{% render 'icon', name: 'bag' %} Meus pedidos</a>{% endif %}{% if settings.whatsapp != blank %}<a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{% render 'icon', name: 'chat' %} Atendimento</a>{% endif %}</div><div class="vm-menu-links"><h2>Navegue por categoria</h2><a href="{{ routes.all_products_collection_url }}">Todos os vinhos <span>→</span></a>{% for category in categories %}{% capture destination %}{% render 'category-link', category: category %}{% endcapture %}<a href="{{ destination | strip }}">{{ labels[forloop.index0] }} <span>›</span></a>{% endfor %}<a href="{{ routes.root_url }}#paises">Países <span>›</span></a><a href="{{ routes.root_url }}#bodegas">Marcas <span>›</span></a><a href="{{ routes.root_url }}#novidades">Novidades <span>›</span></a>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div><p class="vm-menu-signature">Vinhos com identidade.<br>Momentos que ficam.</p></nav></div></header>
<dialog class="zip-wishlist" data-wishlist-dialog aria-label="Meus favoritos"><div><h2>Meus favoritos</h2><button type="button" data-dialog-close aria-label="Fechar">{% render 'icon', name: 'close' %}</button></div><div data-wishlist-items></div><p>Favoritos salvos neste navegador.</p></dialog>
{% schema %}{"name": "Videira · Cabeçalho", "settings": [{"type": "link_list", "id": "menu", "label": "Links adicionais do menu móvel"}, {"type": "text", "id": "announcement_shipping", "label": "Mensagem de envio", "default": "ENVIO PARA TODO O BRASIL"}, {"type": "text", "id": "announcement_campaign", "label": "Mensagem de campanha", "default": "BLACK VIDEIRA · 27 A 30 DE NOVEMBRO"}]}{% endschema %}
