<section id="{{ section.settings.anchor | default: 'bodegas' | escape }}" class="vm-brands vm-container" data-horizontal-carousel style="--producer-logo-height:{{ section.settings.logo_height }}px"><div class="vm-section-heading"><h2>{{ section.settings.title | escape }}</h2><div class="vm-inline-controls"><button type="button" data-row-prev aria-label="Produtores anteriores">‹</button><button type="button" data-row-next aria-label="Próximos produtores">›</button></div></div><div class="vm-brand-track" data-row-track tabindex="0" aria-label="Produtores de vinho">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<a class="vm-producer-tile{% if block.settings.logo %} vm-producer-has-logo{% endif %}" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.all_products_collection_url }}?view=descobrir&amp;produtor={{ block.settings.title | url_encode }}{% endif %}" {{ block.shopify_attributes }}>{% if block.settings.logo %}{{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.title }}{% endif %}{% if section.settings.show_names or block.settings.logo == blank %}<span>{{ block.settings.title | escape }}</span>{% endif %}</a>{% endfor %}{% else %}{% for vendor in shop.vendors %}<a href="{{ routes.all_products_collection_url }}?view=descobrir&amp;produtor={{ vendor | url_encode }}"><span>{{ vendor | escape }}</span></a>{% endfor %}{% endif %}</div></section>
{% schema %}{"name": "Videira · Produtores", "settings": [{"type": "text", "id": "title", "label": "Título", "default": "Produtores"}, {"type": "text", "id": "anchor", "label": "Identificador do link", "default": "bodegas"}, {"type": "range", "id": "logo_height", "label": "Altura das logos", "min": 24, "max": 120, "step": 4, "default": 56}, {"type": "checkbox", "id": "show_names", "label": "Exibir nome junto à logo", "default": true}], "presets": [{"name": "Videira · Produtores", "blocks": [{"type": "producer"}, {"type": "producer"}, {"type": "producer"}, {"type": "producer"}]}], "blocks": [{"type": "producer", "name": "Produtor", "settings": [{"type": "text", "id": "title", "label": "Nome do produtor", "default": "Produtor"}, {"type": "image_picker", "id": "logo", "label": "Logo do produtor"}, {"type": "url", "id": "link", "label": "Destino personalizado"}]}]}{% endschema %}
