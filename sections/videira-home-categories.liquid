<section class="mi-categories vm-shortcuts" aria-label="{{ section.settings.label | escape }}"><div>{% for block in section.blocks %}{% assign scene = '768 0 768 512' %}{% capture destination %}{{ routes.all_products_collection_url }}{% endcapture %}{% case block.settings.style %}{% when 'malbec' %}{% capture destination %}{{ routes.search_url }}?type=product&amp;q=malbec{% endcapture %}{% when 'new' %}{% assign scene = '0 0 768 512' %}{% capture destination %}{{ routes.all_products_collection_url }}?sort_by=created-descending{% endcapture %}{% when 'pizza' %}{% assign scene = '0 512 768 512' %}{% capture destination %}{{ routes.all_products_collection_url }}?view=descobrir&amp;harmonizacao=pizzas{% endcapture %}{% when 'sharing' %}{% assign scene = '768 512 768 512' %}{% endcase %}<a{% if block.settings.style == 'malbec' %} class="vm-malbec-tile"{% endif %} href="{{ block.settings.link | default: destination | strip }}" {{ block.shopify_attributes }}><div class="vm-shortcut-photo">{% if block.settings.image %}{{ block.settings.image | image_url: width: 700 | image_tag: alt: block.settings.title, loading: 'lazy' }}{% elsif block.settings.style == 'malbec' %}<img src="{{ 'videira-malbec.webp' | asset_url }}" alt="Becas Reserva Malbec" width="480" height="640" loading="lazy">{% else %}<svg viewBox="{{ scene }}" preserveAspectRatio="xMidYMid slice" role="img" aria-label="{{ block.settings.title | escape }}"><image href="{{ 'videira-caixa-occasions.webp' | asset_url }}" width="1536" height="1024"/></svg>{% endif %}</div><div class="vm-shortcut-copy"><span>{{ block.settings.title | escape }}</span>{% if block.settings.subtitle != blank %}<small>{{ block.settings.subtitle | escape }}</small>{% endif %}{% render 'icon', name: 'arrow' %}</div></a>{% endfor %}</div></section>
{% schema %}{"name": "Videira · Atalhos", "settings": [{"type": "text", "id": "label", "label": "Descrição da seção", "default": "Seleções de vinho"}], "presets": [{"name": "Videira · Atalhos", "blocks": [{"type": "category"}]}], "blocks": [{"type": "category", "name": "Atalho com imagem", "settings": [{"type": "text", "id": "title", "label": "Nome", "default": "Seleção Videira"}, {"type": "text", "id": "subtitle", "label": "Descrição curta", "default": "Descubra a seleção"}, {"type": "image_picker", "id": "image", "label": "Imagem"}, {"type": "url", "id": "link", "label": "Destino"}, {"type": "select", "id": "style", "label": "Imagem e destino padrão", "default": "selection", "options": [{"value": "malbec", "label": "Malbec"}, {"value": "new", "label": "Novidades"}, {"value": "selection", "label": "Seleção Videira"}, {"value": "pizza", "label": "Vinho e pizza"}, {"value": "sharing", "label": "Para compartilhar"}]}]}]}{% endschema %}
