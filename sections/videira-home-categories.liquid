<section class="mi-categories vm-campaign-minis" style="--mini-count:{{ section.blocks.size }}" aria-label="{{ section.settings.label | escape }}"><div>{% for block in section.blocks %}{% assign file = 'videira-malbec-scene.webp' %}{% capture destination %}{{ routes.all_products_collection_url }}{% endcapture %}{% case block.settings.style %}{% when 'malbec' %}{% capture destination %}{{ routes.all_products_collection_url }}?view=descobrir&amp;uva=Malbec{% endcapture %}{% when 'new' %}{% assign file = 'videira-campanha-chegou-desktop.webp' %}{% capture destination %}{{ routes.all_products_collection_url }}?sort_by=created-descending{% endcapture %}{% when 'selection' %}{% assign file = 'mistral-selecao.jpg' %}{% when 'pizza' %}{% assign file = 'mistral-pizza.png' %}{% capture destination %}{{ routes.all_products_collection_url }}?view=descobrir&amp;harmonizacao=pizzas{% endcapture %}{% when 'kits' %}{% assign file = 'videira-campanha-caixa-desktop.webp' %}{% capture destination %}{{ routes.all_products_collection_url }}?view=descobrir&amp;modo=caixas{% endcapture %}{% when 'sharing' %}{% assign file = 'mistral-kits.jpg' %}{% endcase %}<a{% if block.settings.style == 'malbec' %} class="vm-malbec-tile vm-mini--malbec"{% else %} class="vm-mini--{{ block.settings.style }}"{% endif %} href="{{ block.settings.link | default: destination | strip }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 700 | image_tag: alt: block.settings.title, loading: 'lazy' }}{% else %}<img src="{{ file | asset_url }}" alt="{{ block.settings.title | escape }}" width="300" height="400" loading="lazy">{% endif %}<span>{{ block.settings.title | escape }}</span></a>{% endfor %}</div></section>
{% schema %}
{
  "name": "Videira · Atalhos",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Descrição da seção",
      "default": "Seleções de vinho"
    }
  ],
  "presets": [
    {
      "name": "Videira · Atalhos",
      "blocks": [
        {
          "type": "category"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Atalho com imagem",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nome",
          "default": "Seleção Videira"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destino"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Imagem e destino padrão",
          "default": "selection",
          "options": [
            {
              "value": "malbec",
              "label": "Malbec"
            },
            {
              "value": "new",
              "label": "Novidades"
            },
            {
              "value": "selection",
              "label": "Seleção Videira"
            },
            {
              "value": "pizza",
              "label": "Vinho e pizza"
            },
            {
              "value": "sharing",
              "label": "Para compartilhar"
            },
            {
              "value": "kits",
              "label": "Caixas e kits"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
