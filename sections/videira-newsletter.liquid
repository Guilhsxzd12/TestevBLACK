<section class="vm-newsletter" id="newsletter-{{ section.id }}"><div class="vm-container"><div><h2>{{ section.settings.title | escape }}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p></div>{% assign newsletter_id = 'VideiraNewsletter-' | append: section.id %}{% form 'customer', id: newsletter_id, class: 'nv-newsletter-form vm-newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<div class="vm-newsletter-feedback vm-newsletter-success" data-newsletter-success role="status" tabindex="-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m7 12 3 3 7-7"/></svg><div><h3>{{ section.settings.success_title | escape }}</h3><p>{{ section.settings.success_text | escape | newline_to_br }}</p></div></div>{% else %}{% if form.errors %}<div class="vm-newsletter-feedback vm-newsletter-error" data-newsletter-error role="alert" tabindex="-1"><strong>Não foi possível concluir sua inscrição.</strong>{{ form.errors | default_errors }}</div>{% endif %}<label class="vm-sr-only" for="NewsletterName-{{ section.id }}">Seu nome</label><input id="NewsletterName-{{ section.id }}" name="contact[first_name]" placeholder="Seu nome" autocomplete="given-name"><label class="vm-sr-only" for="NewsletterEmail-{{ section.id }}">Seu e-mail</label><input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="Seu e-mail" required autocomplete="email"><label class="mi-newsletter-consent"><input type="checkbox" required name="contact[accepts_marketing]" value="true"> Tenho mais de 18 anos e aceito receber comunicações da Videira.{% if shop.privacy_policy.url %} <a href="{{ shop.privacy_policy.url }}">Aviso de privacidade</a>{% endif %}</label><button type="submit">{{ section.settings.button_label | escape }}</button>{% endif %}<p class="vm-captcha-notice">Este site é protegido pelo reCAPTCHA. Aplicam-se a <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Política de Privacidade</a> e os <a href="https://policies.google.com/terms" target="_blank" rel="noopener">Termos de Serviço</a> do Google.</p>{% endform %}</div></section>
{% schema %}{"name": "Videira · Newsletter", "settings": [{"type": "text", "id": "title", "label": "Título", "default": "Inscreva-se e receba novidades!"}, {"type": "textarea", "id": "text", "label": "Descrição", "default": "Novos rótulos, seleções e novidades da Videira, direto no seu e-mail."}, {"type": "text", "id": "button_label", "label": "Texto do botão", "default": "INSCREVER"}, {"type": "text", "id": "success_title", "label": "Título de confirmação", "default": "Inscrição recebida com sucesso!"}, {"type": "textarea", "id": "success_text", "label": "Mensagem de confirmação", "default": "Seu cadastro foi recebido pela Videira. Obrigado por fazer parte das nossas próximas descobertas."}], "presets": [{"name": "Videira · Newsletter"}]}{% endschema %}
