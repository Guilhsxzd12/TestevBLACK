{% assign source = section.settings.collection | default: collections.all %}<section id="{{ section.settings.anchor | escape }}" class="mi-good-buys vm-container"><h2>{{ section.settings.title | escape }}</h2><div class="mi-good-grid">{% for product in source.products limit: section.settings.limit %}<a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}<div><span>{{ product.vendor | escape }}</span><h3>{{ product.title | escape }}</h3><small>{{ section.settings.button_label | escape }}</small></div></a>{% endfor %}</div></section>
{% schema %}{"name": "Videira · Boas compras", "settings": [{"type": "text", "id": "title", "label": "Título", "default": "Boas Compras"}, {"type": "text", "id": "anchor", "label": "Identificador do link", "default": "boas-compras"}, {"type": "collection", "id": "collection", "label": "Coleção"}, {"type": "range", "id": "limit", "label": "Quantidade de produtos", "min": 2, "max": 12, "step": 1, "default": 6}, {"type": "text", "id": "button_label", "label": "Texto do link", "default": "Conheça →"}], "presets": [{"name": "Videira · Boas compras"}]}{% endschema %}
