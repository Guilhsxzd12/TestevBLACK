{% assign destination = section.settings.link %}{% if destination == blank %}{% if section.settings.style == 'story' %}{% assign destination = routes.all_products_collection_url %}{% else %}{% assign destination = routes.root_url | append: '#paises' %}{% endif %}{% endif %}{% if section.settings.style == 'story' %}<section class="mi-story">{% if section.settings.image %}{{ section.settings.image | image_url: width: 2000 | image_tag: alt: section.settings.image_alt, loading: 'lazy' }}{% else %}<img src="{{ 'mistral-vineyard.jpeg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1600" height="900" loading="lazy">{% endif %}<div><span>{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}{% if section.settings.heading_second != blank %}<br>{{ section.settings.heading_second | escape }}{% endif %}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p><a class="mi-outline" href="{{ destination }}">{{ section.settings.button_label | escape }}</a></div></section>{% else %}<section class="mi-origin-feature vm-container"><div><span class="vm-eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}{% if section.settings.heading_second != blank %}<br>{{ section.settings.heading_second | escape }}{% endif %}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p><a class="mi-outline" href="{{ destination }}">{{ section.settings.button_label | escape }}</a></div>{% if section.settings.image %}{{ section.settings.image | image_url: width: 2000 | image_tag: alt: section.settings.image_alt, loading: 'lazy' }}{% else %}<img src="{{ 'mistral-vineyard.jpeg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1600" height="900" loading="lazy">{% endif %}</section>{% endif %}
{% schema %}{"name": "Videira · Editorial", "settings": [{"type": "select", "id": "style", "label": "Composição", "default": "origin", "options": [{"value": "origin", "label": "Imagem à direita"}, {"value": "story", "label": "Imagem e texto da marca"}]}, {"type": "text", "id": "eyebrow", "label": "Chamada", "default": "CONHEÇA"}, {"type": "text", "id": "heading", "label": "Título — linha 1", "default": "Uma seleção."}, {"type": "text", "id": "heading_second", "label": "Título — linha 2", "default": "Muitas origens."}, {"type": "textarea", "id": "text", "label": "Texto", "default": "Descubra os vinhos e produtores que fazem parte da Videira."}, {"type": "image_picker", "id": "image", "label": "Imagem"}, {"type": "text", "id": "image_alt", "label": "Descrição da imagem", "default": "Paisagem de vinhedos"}, {"type": "text", "id": "button_label", "label": "Texto do botão", "default": "Explore as origens"}, {"type": "url", "id": "link", "label": "Destino do botão"}], "presets": [{"name": "Videira · Editorial"}]}{% endschema %}
