{% assign source = section.settings.featured_collection | default: collections.all %}
<section id="black-friday" class="mi-hero" data-banner-slider data-autoplay="{{ section.settings.autoplay }}"><h1 class="vm-sr-only">Videira Vinhoteca — a sua seleção de vinhos</h1><div class="mi-hero-stage"><div data-banner-slide><a href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}"><picture><source media="(max-width:760px)" srcset="{% if section.settings.mobile_image %}{{ section.settings.mobile_image | image_url: width: 1000 }}{% else %}{{ 'videira-banner-mobile.webp' | asset_url }}{% endif %}">{% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 2400 | image_tag: fetchpriority: 'high', alt: 'Esquenta Black Friday Videira' }}{% else %}<img src="{{ 'mistral-hero-desktop.jpg' | asset_url }}" alt="Esquenta Black Friday Videira" width="2880" height="1080" fetchpriority="high">{% endif %}</picture></a></div><div data-banner-slide hidden><a class="vm-arrivals-banner" href="{{ routes.root_url }}#novidades"><picture><source media="(max-width:760px)" srcset="{{ 'videira-arrivals-mobile.webp' | asset_url }}"><img src="{{ 'videira-arrivals-desktop.webp' | asset_url }}" alt="Acabou de chegar — Novidades no catálogo Videira. Caixa de vinhos com a marca Videira Vinhoteca." width="2048" height="768" loading="lazy"></picture></a></div>{% for block in section.blocks %}{% if block.type == 'banner' and block.settings.image %}<div data-banner-slide hidden><a href="{{ block.settings.link | default: routes.all_products_collection_url }}"><picture>{% if block.settings.mobile_image %}<source media="(max-width:760px)" srcset="{{ block.settings.mobile_image | image_url: width: 1000 }}">{% endif %}{{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', alt: block.settings.title }}</picture></a></div>{% endif %}{% endfor %}</div><div class="mi-banner-dots"><button type="button" data-banner-dot="0" aria-label="Mostrar banner 1" aria-pressed="true"></button><button type="button" data-banner-dot="1" aria-label="Mostrar banner 2" aria-pressed="false"></button>{% assign slide_number = 2 %}{% for block in section.blocks %}{% if block.type == 'banner' and block.settings.image %}<button type="button" data-banner-dot="{{ slide_number }}" aria-label="Mostrar banner {{ slide_number | plus: 1 }}" aria-pressed="false"></button>{% assign slide_number = slide_number | plus: 1 %}{% endif %}{% endfor %}</div></section>
<section class="mi-categories" aria-label="Seleções de vinho"><div>{% assign names = 'SELEÇÃO MALBEC,NOVIDADES,SELEÇÃO VIDEIRA,VINHO E PIZZA,PARA COMPARTILHAR' | split: ',' %}{% assign files = 'videira-malbec.webp,videira-novidades.webp,mistral-selecao.jpg,mistral-pizza.png,mistral-kits.jpg' | split: ',' %}{% assign destinations = 'malbec,new,all,tinto,all' | split: ',' %}{% for name in names %}{% capture destination %}{% if forloop.first %}{{ routes.search_url }}?type=product&amp;q=malbec{% elsif name == 'VINHO E PIZZA' %}{{ routes.all_products_collection_url }}?view=descobrir&amp;harmonizacao=pizzas{% else %}{% render 'category-link', category: destinations[forloop.index0] %}{% endif %}{% endcapture %}<a{% if forloop.first %} class="vm-malbec-tile"{% endif %} href="{{ destination | strip }}"><img src="{{ files[forloop.index0] | asset_url }}" alt="{{ name }}" width="300" height="400" loading="lazy"><span>{{ name }}</span></a>{% endfor %}</div></section>
{% render 'pairing-carousel' %}
{% render 'store-shelf', products: source.products, title: 'Seleção da Videira', logo: section.settings.featured_logo, subtitle: 'Vinhos para descobrir e compartilhar', anchor: 'selecao' %}
<section id="boas-compras" class="mi-good-buys vm-container"><h2>Boas Compras</h2><div class="mi-good-grid">{% for product in source.products limit: 6 %}<a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}<div><span>{{ product.vendor | escape }}</span><h3>{{ product.title | escape }}</h3><small>Conheça →</small></div></a>{% endfor %}</div></section>
<section class="mi-origin-feature vm-container"><div><span class="vm-eyebrow">CONHEÇA</span><h2>Uma seleção.<br>Muitas origens.</h2><p>Descubra os vinhos e produtores que fazem parte da Videira.</p><a class="mi-outline" href="{{ routes.root_url }}#paises">Explore as origens</a></div><img src="{{ 'mistral-vineyard.jpeg' | asset_url }}" alt="Paisagem de vinhedos" width="1600" height="900" loading="lazy"></section>
{% assign newest = section.settings.new_collection | default: source %}{% assign newest_products = newest.products | sort: 'created_at' | reverse %}{% render 'store-shelf', products: newest_products, title: 'Novidades', logo: section.settings.new_logo, subtitle: 'Encontre seu próximo favorito', anchor: 'novidades' %}
<section id="paises" class="vm-origins vm-container" data-horizontal-carousel><div class="vm-section-heading"><h2>Países e regiões</h2><div class="vm-inline-controls"><button type="button" data-row-prev aria-label="Países anteriores">‹</button><button type="button" data-row-next aria-label="Próximos países">›</button></div></div><div class="vm-origins-track" data-row-track tabindex="0" aria-label="Países de origem">{% assign country_blocks = section.blocks | where: 'type', 'country' %}{% if country_blocks.size > 0 %}{% for block in country_blocks %}<a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% render 'country-flag', country: block.settings.title %}<strong>{{ block.settings.title | escape }}</strong><small>Conheça →</small></a>{% endfor %}{% else %}{% assign countries = 'Argentina,Chile,Brasil' | split: ',' %}{% assign queries = 'vendor:"Gascón" OR vendor:"Susana Balbo" OR vendor:"Mosquita Muerta" OR vendor:"Martino" OR vendor:"Puna",vendor:"Becas",vendor:"Casa Valduga" OR vendor:"Ponto Nero"' | split: ',' %}{% for country in countries %}<a href="{{ routes.all_products_collection_url }}?view=descobrir&amp;pais={{ country | url_encode }}">{% render 'country-flag', country: country %}<strong>{{ country }}</strong><small>Conheça →</small></a>{% endfor %}{% endif %}</div></section>
<section id="bodegas" class="vm-brands vm-container" data-horizontal-carousel><div class="vm-section-heading"><h2>Produtores</h2><div class="vm-inline-controls"><button type="button" data-row-prev aria-label="Produtores anteriores">‹</button><button type="button" data-row-next aria-label="Próximos produtores">›</button></div></div><div class="vm-brand-track" data-row-track tabindex="0" aria-label="Produtores de vinho">{% assign producers = section.blocks | where: 'type', 'producer' %}{% if producers.size > 0 %}{% for block in producers %}<a class="vm-producer-tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% if block.settings.logo != blank %}{{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name }}{% endif %}<span>{{ block.settings.name | escape }}</span></a>{% endfor %}{% else %}{% for vendor in shop.vendors %}<a href="{{ vendor | url_for_vendor }}"><span>{{ vendor | escape }}</span></a>{% endfor %}{% endif %}</div></section>
<section class="mi-story"><img src="{{ 'mistral-vineyard.jpeg' | asset_url }}" alt="Vinhedos e suas origens" width="1600" height="900" loading="lazy"><div><span>VIDEIRA VINHOTECA</span><h2>Vinhos com identidade.<br>Momentos que ficam.</h2><p>O seu próximo vinho está aqui.</p><a class="mi-outline" href="{{ routes.all_products_collection_url }}">Conheça</a></div></section>
{% schema %}{"name": "Videira · Loja (legado)", "settings": [{"type": "image_picker", "id": "hero_image", "label": "Banner — computador"}, {"type": "image_picker", "id": "mobile_image", "label": "Banner — celular"}, {"type": "url", "id": "hero_link", "label": "Destino do banner"}, {"type": "checkbox", "id": "autoplay", "label": "Alternar banners automaticamente", "default": true}, {"type": "collection", "id": "featured_collection", "label": "Coleção principal"}, {"type": "collection", "id": "new_collection", "label": "Coleção de novidades"}, {"type": "image_picker", "id": "featured_logo", "label": "Logo da vitrine principal"}, {"type": "image_picker", "id": "new_logo", "label": "Logo da vitrine de novidades"}], "blocks": [{"type": "banner", "name": "Banner adicional", "settings": [{"type": "text", "id": "title", "label": "Descrição", "default": "Seleção Videira"}, {"type": "image_picker", "id": "image", "label": "Arte — computador"}, {"type": "image_picker", "id": "mobile_image", "label": "Arte — celular"}, {"type": "url", "id": "link", "label": "Destino"}]}, {"type": "country", "name": "País", "settings": [{"type": "text", "id": "title", "label": "Nome", "default": "Portugal"}, {"type": "url", "id": "link", "label": "Coleção ou destino"}]}, {"type": "producer", "name": "Produtor com logo", "settings": [{"type": "text", "id": "name", "label": "Nome do produtor", "default": "Produtor"}, {"type": "image_picker", "id": "logo", "label": "Logo do produtor"}, {"type": "url", "id": "link", "label": "Coleção ou página do produtor"}]}]}{% endschema %}
