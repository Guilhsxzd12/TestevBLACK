{%- liquid
 assign fact = nil
 assign standard_key = ''
 case field
  when 'volume'
   assign keys = 'volume,volume_da_garrafa,conteudo,conteudo_liquido,conte_do,conte_do_l_quido,ml,capacidade,volume_ml,tamanho_da_garrafa'
   assign standard_key = 'volume'
  when 'case_size'
   assign keys = 'caixa,quantidade_caixa,quantidade_por_caixa,unidades_caixa,unidades_na_caixa,quantidade_de_itens_na_caixa,quantidade_itens_caixa,quantidade_garrafas_caixa,garrafas_caixa,qtde_caixa,qtd_por_caixa,caixa,quantidade_de_garrafas_na_caixa,quantidade_de_unidades_na_caixa,unidades_por_caixa,garrafas_por_caixa,quantidade_de_garrafas,quantidade_da_caixa,qtd_caixa,bottles_per_case,bottles_per_box,units_per_case,units_per_box,box_quantity,pack_size,numero_de_garrafas_por_caixa,numero_de_unidades_por_caixa,case_size'
  when 'country'
   assign keys = 'country,pais,pa_s,pais_de_origem,origem_pais'
   assign standard_key = 'country'
  when 'grape'
   assign keys = 'blends,uvas_do_blend,uvas_blend,blend_de_uvas,uvas,castas,composicao_de_uvas,uvas_do_vinho,grape,uva,uva_s,variedade_de_uvas,blend'
   assign standard_key = 'grape-variety'
  when 'region'
   assign keys = 'region,regiao,regi_o,regiao_do_vinho,regiao_de_origem,regiao_produtora'
   assign standard_key = 'wine-region'
  when 'alcohol'
   assign keys = 'grau_alcoolico,grau_alco_lico,graduacao_alcoolica,gradua_o_alco_lica,teor_alcoolico,teor_alco_lico,alcohol,alcool,alcohol_content'
   assign standard_key = 'alcohol-content'
  when 'aging'
   assign keys = 'amadurecimento,envelhecimento,maturacao,matura_o,aging'
  when 'pairing'
   assign keys = 'harmonizacao,harmoniza_o,harmonizacoes,harmoniza_es,harmonizacao_gastronomica,pairing'
  when 'aromas'
   assign keys = 'aromas,aroma'
  when 'palate'
   assign keys = 'paladar,palate'
  when 'visual'
   assign keys = 'visual,aspecto_visual'
 endcase
 assign names = keys | split: ','
 for key in names
  assign candidate = product.metafields.custom[key]
  if candidate != blank and candidate.type != 'boolean'
   assign fact = candidate
   break
  endif
 endfor
 if fact == nil or fact == blank
  for property in product.metafields.custom
   assign candidate = property.last
   assign key = property.first | downcase | remove: '_' | remove: '-' | replace: 'í', 'i' | replace: 'ã', 'a'
   assign matches = false
   case field
    when 'case_size'
     if key contains 'caixa' or key contains 'case' or key contains 'box'
      if key contains 'quant' or key contains 'qtd' or key contains 'unidade' or key contains 'garrafa' or key contains 'size' or key contains 'bottle' or key contains 'unit' or key == 'caixa'
       if candidate.type contains 'number' or candidate.type contains 'text' or candidate.type == blank
        assign matches = true
       endif
      endif
     endif
    when 'grape'
     if key contains 'uva' or key contains 'casta' or key contains 'blend'
      unless key contains 'chuva'
       assign matches = true
      endunless
     endif
    when 'alcohol'
     if key contains 'alco' or key == 'abv'
      assign matches = true
     endif
    when 'aging'
     if key contains 'amadurec' or key contains 'envelhec' or key contains 'matura'
      assign matches = true
     endif
    when 'pairing'
     if key contains 'harmoniz'
      assign matches = true
     endif
    when 'aromas'
     if key contains 'aroma'
      assign matches = true
     endif
    when 'palate'
     if key contains 'paladar' or key contains 'palate'
      assign matches = true
     endif
    when 'visual'
     if key contains 'visual'
      assign matches = true
     endif
   endcase
   if matches and candidate != blank and candidate.type != 'boolean'
    assign fact = candidate
    break
   endif
  endfor
 endif
 if fact == nil and standard_key != blank
  assign fact = product.metafields.shopify[standard_key] | default: product.selected_or_first_available_variant.metafields.shopify[standard_key]
 endif
 if field == 'region' and fact == nil
  assign fact = product.metafields.shopify.region
 endif
-%}
{%- capture fact_text -%}
 {%- if fact -%}
  {%- if fact.type contains 'list.' -%}
   {%- assign separator = '' -%}{%- for entry in fact.value -%}
    {%- assign label = entry.label.value | default: entry.label | default: entry.name.value | default: entry.name | default: entry -%}
    {%- unless label contains 'gid://' -%}{%- if label != blank -%}{{- separator -}}{{- label | escape -}}{%- assign separator = ', ' -%}{%- endif -%}{%- endunless -%}
   {%- endfor -%}
  {%- elsif field == 'grape' and fact.type == 'multi_line_text_field' -%}
   {{- fact | metafield_text | newline_to_br | replace: '<br />', ', ' | strip_newlines | strip_html | escape -}}
  {%- elsif fact.type == 'metaobject_reference' -%}
   {%- assign label = fact.value.label.value | default: fact.value.label | default: fact.value.name.value | default: fact.value.name -%}{{- label | escape -}}
  {%- else -%}{{- fact | metafield_text | strip_html | escape -}}{%- endif -%}
 {%- endif -%}
{%- endcapture -%}
{%- assign fact_text = fact_text | strip -%}
{%- if field == 'grape' and fact_text == 'Outro' -%}{%- assign fact_text = '' -%}{%- endif -%}
{%- if field == 'volume' -%}
 {%- if fact_text != blank -%}{{- fact_text -}}{%- assign remainder = fact_text | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: ',' | remove: '.' | strip -%}{%- if remainder == '' -%}{{- ' ml' -}}{%- endif -%}{%- endif -%}
{%- elsif field == 'alcohol' -%}
 {%- assign sem_alcool = product.metafields.custom.sem_alcool.value | default: product.metafields.custom.sem_alco_ol.value -%}
 {%- assign normalized_alcohol = fact_text | downcase | remove: '%' | strip -%}
 {%- if sem_alcool == true or normalized_alcohol == '0' or normalized_alcohol == '0.0' or normalized_alcohol == '0,0' or normalized_alcohol contains 'sem álcool' -%}Sem álcool
 {%- elsif fact_text != blank -%}{%- assign numeric_remainder = fact_text | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: ',' | remove: '.' | strip -%}{{- fact_text -}}{%- if numeric_remainder == '' -%}%{%- endif -%}{%- endif -%}
{%- elsif fact_text != blank -%}{{- fact_text -}}
{%- elsif field == 'grape' -%}
 {%- assign wine_title = product.title | downcase -%}{%- assign grape_names = 'Cabernet Sauvignon,Sauvignon Blanc,Chardonnay,Chenin Blanc,Pinot Noir,Malbec,Merlot,Syrah,Shiraz,Tannat,Tempranillo' | split: ',' -%}{%- assign separator = '' -%}
 {%- for grape in grape_names -%}{%- assign token = grape | downcase -%}{%- if wine_title contains token -%}{{- separator -}}{{- grape -}}{%- assign separator = ', ' -%}{%- endif -%}{%- endfor -%}
 {%- if separator == '' -%}{%- if wine_title contains 'carménère' or wine_title contains 'carmenere' or wine_title contains 'carmenérè' -%}Carménère{%- elsif wine_title contains 'moscatel' -%}Moscatel{%- endif -%}{%- endif -%}
{%- elsif field == 'region' -%}
 {%- assign description = product.description | strip_html | downcase -%}{%- if description contains 'de mendoza' or description contains 'em mendoza' -%}Mendoza{%- elsif description contains 'produzido na serra gaúcha' -%}Serra Gaúcha{%- endif -%}
{%- endif -%}
