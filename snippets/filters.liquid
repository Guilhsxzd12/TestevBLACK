<div id="catalog-filters" class="vm-inline-filters" data-filter-panel hidden><form method="get" action="{{ collection.url }}"><div class="vm-filter-header"><h2>Filtrar vinhos</h2><button type="button" data-filter-close aria-label="Fechar filtros">{% render 'icon', name: 'close' %}</button></div><input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}"><div class="vm-filter-groups">{% for filter in collection.filters %}<details class="vm-filter-group" name="catalog-facet"><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %}<small>{{ filter.active_values.size }}</small>{% endif %}<span>⌄</span></summary><div class="vm-filter-group-body"><fieldset><legend class="vm-sr-only">{{ filter.label | escape }}</legend>{% case filter.type %}{% when 'list','boolean' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}><span>{{ value.label | escape }}</span><small>{{ value.count }}</small></label>{% endfor %}{% when 'price_range' %}<div class="vm-inline-price"><label>De R$<input type="number" min="0" step="0.01" name="{{ filter.min_value.param_name }}"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>Até R$<input type="number" min="0" step="0.01" name="{{ filter.max_value.param_name }}"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label></div>{% endcase %}</fieldset></div></details>{% endfor %}</div><div class="vm-filter-actions"><a href="{{ collection.url }}">Limpar</a><button type="submit">Aplicar filtros</button></div></form></div>
