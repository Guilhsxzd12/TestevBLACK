{% capture card_volume %}{% render 'product-fact', product: product, field: 'volume' %}{% endcapture %}{% assign card_volume = card_volume | strip %}
{% capture card_country %}{% render 'product-fact', product: product, field: 'country' %}{% endcapture %}{% assign card_country = card_country | strip %}{% capture card_grape %}{% render 'product-fact', product: product, field: 'grape' %}{% endcapture %}{% assign card_grape = card_grape | strip %}{% capture card_region %}{% render 'product-fact', product: product, field: 'region' %}{% endcapture %}{% assign card_region = card_region | strip %}
{% assign country_key = card_country | downcase %}{% assign country_color = 'neutral' %}{% if country_key contains 'argentin' %}{% assign country_color = 'argentina' %}{% elsif country_key contains 'chile' %}{% assign country_color = 'chile' %}{% elsif country_key contains 'brasil' or country_key contains 'brazil' %}{% assign country_color = 'brasil' %}{% elsif country_key contains 'portug' %}{% assign country_color = 'portugal' %}{% elsif country_key contains 'fran' %}{% assign country_color = 'franca' %}{% elsif country_key contains 'ital' or country_key contains 'itál' %}{% assign country_color = 'italia' %}{% elsif country_key contains 'espan' or country_key contains 'spain' %}{% assign country_color = 'espanha' %}{% elsif country_key contains 'urug' %}{% assign country_color = 'uruguai' %}{% endif %}
{% assign card_variant = product.selected_or_first_available_variant %}{% assign display_variant = card_variant %}{% for option in product.variants %}{% if option.available and option.price < display_variant.price %}{% assign display_variant = option %}{% endif %}{% endfor %}{% assign display_price = display_variant.price | default: product.price %}{% assign display_compare = display_variant.compare_at_price | default: 0 %}
<article class="sf-wine-card vm-product-card"><button class="zip-favorite" type="button" data-favorite data-product-key="{{ product.id }}" data-favorite-title="{{ product.title | replace: 'Carménére', 'Carménère' | escape }}" data-favorite-url="{{ product.url }}" aria-label="Favoritar {{ product.title | replace: 'Carménére', 'Carménère' | escape }}" aria-pressed="false">{% render 'icon', name: 'heart' %}</button><a class="sf-wine-visual" href="{{ product.url }}" aria-label="{{ product.title | replace: 'Carménére', 'Carménère' | escape }}">{% if display_compare > display_price %}<span class="vm-sale-badge">Oferta</span>{% endif %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: class: 'wine-photo', loading: 'lazy', widths: '180,360,540,720', sizes: '(max-width: 760px) 45vw, 280px', alt: product.title }}{% else %}<span class="wine-photo-placeholder">{% render 'icon', name: 'glass' %}<small>{{ 'product.no_image' | t }}</small></span>{% endif %}{% if card_volume != blank %}<span class="vm-card-volume">{{ card_volume }}</span>{% endif %}</a><div class="mi-card-strip vm-country-band vm-country-{{ country_color }}">{% render 'technical-icon', name: 'country' %}<span>{{ card_country | default: 'Origem não informada' }}</span></div><div class="sf-wine-info"><div class="vm-card-details"><a class="vm-card-title" href="{{ product.url }}"><h3>{{ product.title | replace: 'Carménére', 'Carménère' | escape }}</h3></a><div class="vm-card-brand">{% assign producer_logo = product.metafields.custom.producer_logo.value | default: product.metafields.custom.brand_logo.value %}{% if producer_logo %}{{ producer_logo | image_url: width: 240 | image_tag: class: 'vm-card-producer-logo', loading: 'lazy', alt: product.vendor }}{% endif %}<p class="vm-card-vendor">{{ product.vendor | escape }}</p></div><div class="vm-card-facts{% if product.title.size < 33 and card_grape.size < 27 %} vm-card-facts--roomy-region{% endif %}"><p>{% if card_grape != blank %}<span>Uvas</span><strong title="{{ card_grape }}">{{ card_grape }}</strong>{% endif %}</p><p>{% if card_region != blank %}<span>Região</span><strong title="{{ card_region }}">{{ card_region }}</strong>{% endif %}</p></div></div><div class="vm-card-purchase"><div class="sf-wine-price"><div class="vm-price-note">{% if product.price_varies %}<small>A partir de</small>{% endif %}{% if display_compare > display_price %}<del>{{ display_compare | money }}</del>{% endif %}</div><strong>{{ display_price | money }}</strong></div>{% if product.available %}{% if product.has_only_default_variant %}{% form 'product', product, class: 'sf-quick-add vm-quick-add', data-shopify-add: '', data-cart-stay: '' %}<input type="hidden" name="return_to" value="{{ routes.cart_url }}"><input type="hidden" name="id" value="{{ card_variant.id }}"><div class="vm-buy-row"><div class="vm-quantity"><button type="button" data-quantity-step="-1" aria-label="Diminuir quantidade de {{ product.title | replace: 'Carménére', 'Carménère' | escape }}">−</button><input type="number" name="quantity" aria-label="Quantidade de {{ product.title | replace: 'Carménére', 'Carménère' | escape }}" value="{{ card_variant.quantity_rule.min | default: 1 }}" min="{{ card_variant.quantity_rule.min | default: 1 }}" step="{{ card_variant.quantity_rule.increment | default: 1 }}"{% if card_variant.quantity_rule.max %} max="{{ card_variant.quantity_rule.max }}"{% endif %}><button type="button" data-quantity-step="1" aria-label="Aumentar quantidade de {{ product.title | replace: 'Carménére', 'Carménère' | escape }}">+</button></div><button class="sf-add vm-cart-add" type="submit" aria-label="Adicionar {{ product.title | replace: 'Carménére', 'Carménère' | escape }} ao carrinho">{% render 'icon', name: 'cart' %}<span data-card-add-label>Adicionar</span></button></div>{% endform %}{% else %}<a class="sf-add" href="{{ product.url }}">Ver opções</a>{% endif %}{% else %}<p class="vm-sold-out">Esse acabou!</p><a class="sf-add vm-unavailable" href="{{ product.url }}">Ver detalhes</a>{% endif %}</div></div></article>
