{% assign card_variant = product.selected_or_first_available_variant %}
<article class="sf-wine-card vm-product-card"><button class="zip-favorite" type="button" data-favorite data-product-key="{{ product.id }}" data-favorite-title="{{ product.title | escape }}" data-favorite-url="{{ product.url }}" aria-label="Favoritar {{ product.title | escape }}" aria-pressed="false">{% render 'icon', name: 'heart' %}</button><a class="sf-wine-visual" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% if product.compare_at_price > product.price %}<span class="vm-sale-badge">Oferta</span>{% endif %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: class: 'wine-photo', loading: 'lazy', widths: '180,360,540,720', sizes: '(max-width: 760px) 45vw, 280px', alt: product.title }}{% else %}<span class="wine-photo-placeholder">{% render 'icon', name: 'glass' %}<small>{{ 'product.no_image' | t }}</small></span>{% endif %}</a><div class="mi-card-strip">{% render 'icon', name: 'bag' %} Seleção Videira</div><div class="sf-wine-info"><a href="{{ product.url }}"><h3>{{ product.title | escape }}</h3></a>{% assign producer_logo = product.metafields.custom.producer_logo.value | default: product.metafields.custom.brand_logo.value %}{% if producer_logo %}{{ producer_logo | image_url: width: 240 | image_tag: class: 'vm-card-producer-logo', loading: 'lazy', alt: product.vendor }}{% endif %}<p class="vm-card-vendor">{{ product.vendor | escape }}</p><p class="mi-card-type">{{ product.type | escape }}{% if product.metafields.custom.grape.value != blank %}, {{ product.metafields.custom.grape.value | escape }}{% endif %}</p><p class="mi-card-country">{{ product.metafields.custom.country.value | escape }}{% if product.metafields.custom.region.value != blank %}, {{ product.metafields.custom.region.value | escape }}{% endif %}</p><div class="sf-wine-price">{% if product.price_varies %}<small>A partir de</small>{% endif %}{% if product.compare_at_price > product.price %}<del>{{ product.compare_at_price | money }}</del>{% endif %}<strong>{{ product.price | money }}</strong></div>{% if product.available %}{% if product.has_only_default_variant %}{% form 'product', product, class: 'sf-quick-add vm-quick-add', data-shopify-add: '' %}<input type="hidden" name="return_to" value="{{ routes.cart_url }}"><input type="hidden" name="id" value="{{ card_variant.id }}"><div class="vm-buy-row"><div class="vm-quantity"><button type="button" data-quantity-step="-1" aria-label="Diminuir quantidade de {{ product.title | escape }}">−</button><input type="number" name="quantity" aria-label="Quantidade de {{ product.title | escape }}" value="{{ card_variant.quantity_rule.min | default: 1 }}" min="{{ card_variant.quantity_rule.min | default: 1 }}" step="{{ card_variant.quantity_rule.increment | default: 1 }}"{% if card_variant.quantity_rule.max %} max="{{ card_variant.quantity_rule.max }}"{% endif %}><button type="button" data-quantity-step="1" aria-label="Aumentar quantidade de {{ product.title | escape }}">+</button></div><button class="sf-add" type="submit">Comprar</button></div>{% endform %}{% else %}<a class="sf-add" href="{{ product.url }}">Ver opções</a>{% endif %}{% else %}<p class="vm-sold-out">Esse acabou!</p><a class="sf-add vm-unavailable" href="{{ product.url }}">Ver detalhes</a>{% endif %}{% if settings.whatsapp != blank %}<a class="vm-whatsapp-buy" href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}?text={{ product.title | prepend: 'Olá! Tenho interesse no vinho ' | url_encode }}" target="_blank" rel="noopener">{% render 'social-icon', name: 'whatsapp' %} Comprar no WhatsApp</a>{% endif %}</div></article>
