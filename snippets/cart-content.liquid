{% doc %}Server-rendered Shopify cart page.{% enddoc %}
{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" class="sf-shopify-cart"><div class="sf-cart-items">{% for item in cart.items %}<div class="sf-cart-item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.product.title }}</a>{% endif %}<div class="sf-cart-line-info"><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.product.has_only_default_variant %}<small>{{ item.variant.title | escape }}</small>{% endunless %}{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<small>{{ property.first | escape }}: {{ property.last | escape }}</small>{% endif %}{% endfor %}{% if item.selling_plan_allocation %}<small>{{ item.selling_plan_allocation.selling_plan.name | escape }}</small>{% endif %}<div class="vm-cart-line-prices">{% if item.original_line_price > item.final_line_price %}<del>{{ item.original_line_price | money }}</del>{% endif %}<strong>{{ item.final_line_price | money }}</strong></div>{% for discount in item.line_level_discount_allocations %}<small class="vm-cart-line-discount">{{ discount.discount_application.title | escape }} · Você economiza {{ discount.amount | money }}</small>{% endfor %}{% assign cart_step = item.variant.quantity_rule.increment | default: 1 %}{% assign cart_min = item.variant.quantity_rule.min | default: 1 %}{% if item.properties._case_size %}{% assign cart_step = item.properties._case_size | plus: 0 | at_least: 1 %}{% assign cart_min = cart_step %}{% endif %}<div class="vm-cart-quantity-row"><span>{{ 'product.quantity' | t }}</span><div class="vm-quantity vm-cart-quantity"><button type="button" data-quantity-step="-1" aria-label="Diminuir quantidade de {{ item.product.title | escape }}">−</button><input aria-label="{{ 'product.quantity' | t }} — {{ item.product.title | escape }}" type="number" min="{{ cart_min }}" step="{{ cart_step }}" name="updates[]" value="{{ item.quantity }}"{% if item.variant.quantity_rule.max %} max="{{ item.variant.quantity_rule.max }}"{% endif %}><button type="button" data-quantity-step="1" aria-label="Aumentar quantidade de {{ item.product.title | escape }}">+</button></div></div><a class="sf-remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div></div>{% endfor %}</div><div class="sf-cart-bottom">{% assign original_total = cart.original_total_price | default: cart.total_price %}{% assign total_saving = original_total | minus: cart.total_price %}{% if total_saving > 0 %}<div class="vm-cart-before-discount"><span>Subtotal sem desconto</span><strong>{{ original_total | money }}</strong></div><div class="vm-cart-discount-total"><span>Descontos aplicados</span><strong>−{{ total_saving | money }}</strong></div>{% endif %}{% for discount in cart.cart_level_discount_applications %}<p class="vm-cart-discount-name">{{ discount.title | escape }}</p>{% endfor %}<div class="vm-cart-grand-total"><span>{% if total_saving > 0 %}Subtotal com desconto{% else %}{{ 'cart.subtotal' | t }}{% endif %}</span><strong>{{ cart.total_price | money }}</strong></div>{% if total_saving > 0 %}<p class="vm-cart-saving">Você economizou <strong>{{ total_saving | money }}</strong> nesta compra.</p>{% endif %}<p>{{ 'cart.delivery' | t }}</p><button class="sf-cart-update" type="submit" name="update">{{ 'cart.update' | t }}</button><button class="sf-button" type="submit" name="checkout">{{ 'cart.checkout' | t }}{% render 'icon', name: 'arrow' %}</button></div></form>{% else %}<div class="sf-empty-cart">{% render 'icon', name: 'bag' %}<h3>{{ 'cart.empty' | t }}</h3><p>{{ 'cart.empty_intro' | t }}</p><a class="sf-button" href="{{ routes.all_products_collection_url }}">{{ 'general.explore_wines' | t }}</a></div>{% endif %}

