{% assign render_limit = product_limit | default: 12 %}
{% if products.size > 0 %}<section class="vm-shelf vm-container wc-section"{% if anchor != blank %} id="{{ anchor }}"{% endif %}><div class="vm-section-heading">{% if logo != blank %}{{ logo | image_url: width: 360 | image_tag: class: 'vm-shelf-logo', loading: 'lazy', alt: title }}{% endif %}<h2>{{ title | escape }}</h2>{% if subtitle != blank %}<p>{{ subtitle | escape }}</p>{% endif %}</div><div class="vm-shelf-wrap"><button type="button" class="vm-shelf-prev" data-carousel-step="-1" aria-label="Vinhos anteriores">‹</button><div class="wc-viewport" tabindex="0" aria-label="{{ title | escape }}"><div class="wc-track"><div class="wc-group">{% for product in products limit: render_limit %}{% render 'product-card', product: product %}{% endfor %}</div></div></div><button type="button" class="vm-shelf-next" data-carousel-step="1" aria-label="Próximos vinhos">›</button></div><a class="mi-outline mi-shelf-all" href="{{ destination | default: routes.all_products_collection_url }}">{{ button_label | default: 'VER TODOS OS VINHOS' | escape }}</a></section>{% endif %}
