<section id="harmonizacoes" class="vm-pairings vm-container" data-horizontal-carousel><div class="vm-section-heading"><h2>Harmonizações</h2><p>Escolha o prato. Descubra o vinho.</p></div><div class="vm-pairings-track" data-row-track tabindex="0" aria-label="Explore vinhos por harmonização">{% assign foods = 'Carnes vermelhas,Pizzas,Queijos,Cozinha oriental,Massas,Frutos do mar,Carnes brancas,Risotos,Peixes,Legumes,Saladas,Sobremesas' | split: ',' %}{% assign food_keys = 'carnes-vermelhas,pizzas,queijos,orientais,massas,frutos-do-mar,carnes-brancas,risotos,peixes,legumes,saladas,sobremesas' | split: ',' %}{% assign food_crops = '184 83 959 965,170 84 973 964,192 89 1054 1053,179 94 1086 1048,196 94 1050 1048,197 94 1049 1048,197 94 1049 1048,193 93 1053 1049,197 95 1049 1047,197 95 1049 1047,174 94 1072 1048,187 94 1059 1048' | split: ',' %}{% for food in foods %}{% assign food_key = food_keys[forloop.index0] %}{% assign food_file = 'food-' | append: food_key | append: '.png' %}<a href="{{ routes.all_products_collection_url }}?view=descobrir&amp;harmonizacao={{ food_key }}"><div class="vm-food-photo">{% assign food_width = 1428 %}{% assign food_height = 1453 %}{% if food_key == 'carnes-vermelhas' or food_key == 'pizzas' %}{% assign food_width = 1309 %}{% assign food_height = 1332 %}{% endif %}<svg viewBox="{{ food_crops[forloop.index0] }}" role="img" aria-label="Prato de {{ food | downcase }}"><image href="{{ food_file | asset_url }}" width="{{ food_width }}" height="{{ food_height }}"/></svg></div><span>{{ food }}</span></a>{% endfor %}</div></section>
