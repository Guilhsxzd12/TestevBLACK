<section id="harmonizacoes" class="vm-pairings vm-container" data-horizontal-carousel><div class="vm-section-heading"><h2>Harmonizações</h2><p>Escolha o prato. Descubra o vinho.</p><div class="vm-inline-controls"><button type="button" data-row-prev aria-label="Harmonizações anteriores">‹</button><button type="button" data-row-next aria-label="Próximas harmonizações">›</button></div></div><div class="vm-pairings-track" data-row-track tabindex="0" aria-label="Explore vinhos por harmonização">{% assign foods = 'Carnes vermelhas,Pizzas,Queijos,Cozinha oriental,Massas,Frutos do mar,Carnes brancas,Risotos,Peixes,Legumes,Saladas,Sobremesas' | split: ',' %}{% assign food_keys = 'carnes-vermelhas,pizzas,queijos,orientais,massas,frutos-do-mar,carnes-brancas,risotos,peixes,legumes,saladas,sobremesas' | split: ',' %}{% for food in foods %}{% assign food_key = food_keys[forloop.index0] %}{% assign food_file = 'food-' | append: food_key | append: '.png' %}<a href="{{ routes.all_products_collection_url }}?view=descobrir&amp;harmonizacao={{ food_key }}"><div class="vm-food-photo"><img src="{{ food_file | asset_url }}" width="280" height="280" loading="lazy" alt="Prato de {{ food | downcase }}"></div><span>{{ food }}</span></a>{% endfor %}</div></section>
