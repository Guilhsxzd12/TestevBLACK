{% assign flag_country = country | downcase %}<span class="vm-country-flag" aria-hidden="true"><svg viewBox="0 0 60 40" fill="none" xmlns="http://www.w3.org/2000/svg">{% if flag_country contains 'argentin' %}<path fill="#77b6df" d="M0 0h60v40H0z"/><path fill="#fff" d="M0 13h60v14H0z"/><circle cx="30" cy="20" r="4" fill="#efb841"/>{% elsif flag_country contains 'chile' %}<path fill="#fff" d="M0 0h60v40H0z"/><path fill="#db2639" d="M0 20h60v20H0z"/><path fill="#184887" d="M0 0h20v20H0z"/><path fill="#fff" d="m10 4 1.4 4.1h4.3l-3.5 2.6 1.3 4.1-3.5-2.5-3.5 2.5 1.3-4.1-3.5-2.6h4.3Z"/>{% elsif flag_country contains 'brasil' or flag_country contains 'brazil' %}<path fill="#18834b" d="M0 0h60v40H0z"/><path fill="#f8d648" d="m30 4 25 16-25 16L5 20Z"/><circle fill="#194e99" cx="30" cy="20" r="10"/><path d="M20 17c6-1 13 1 20 6" stroke="#fff" stroke-width="2"/>{% elsif flag_country contains 'fran' %}<path fill="#fff" d="M0 0h60v40H0z"/><path fill="#20468e" d="M0 0h20v40H0z"/><path fill="#d93646" d="M40 0h20v40H40z"/>{% elsif flag_country contains 'ital' or flag_country contains 'itál' %}<path fill="#fff" d="M0 0h60v40H0z"/><path fill="#168653" d="M0 0h20v40H0z"/><path fill="#ce3344" d="M40 0h20v40H40z"/>{% elsif flag_country contains 'portug' %}<path fill="#d92f3c" d="M0 0h60v40H0z"/><path fill="#087548" d="M0 0h24v40H0z"/><circle fill="#efd056" cx="24" cy="20" r="8"/><path fill="#fff" d="M20 15h8v9l-4 3-4-3z"/>{% elsif flag_country contains 'espan' %}<path fill="#c82b3b" d="M0 0h60v40H0z"/><path fill="#f4ca43" d="M0 10h60v20H0z"/>{% elsif flag_country contains 'urug' %}<path fill="#fff" d="M0 0h60v40H0z"/><path stroke="#5191c8" stroke-width="4" d="M0 7h60M0 15h60M0 23h60M0 31h60"/><path fill="#fff" d="M0 0h22v22H0z"/><circle fill="#edb640" cx="11" cy="11" r="5"/>{% else %}<circle cx="30" cy="20" r="17" stroke="#b59758" stroke-width="2"/><ellipse cx="30" cy="20" rx="8" ry="17" stroke="#b59758"/><path d="M13 20h34" stroke="#b59758"/>{% endif %}</svg></span>
