{%- capture pack_size_text -%}{%- render 'product-fact', product: product, field: 'case_size' -%}{%- endcapture -%}
{%- assign pack_size = pack_size_text | strip | plus: 0 -%}{%- assign rounded_size = pack_size | floor -%}
{%- assign pack_type = product.type | downcase -%}{%- assign pack_title = product.title | downcase | slice: 0, 5 -%}{%- assign packaged = false -%}
{%- if pack_type contains 'kit' or pack_type contains 'caixa' or pack_title contains 'caixa' or pack_title contains 'kit ' or product.metafields.custom.preco_por_caixa.value == true -%}{%- assign packaged = true -%}{%- endif -%}
{%- if packaged or pack_size >= 2 and pack_size == rounded_size -%}
{%- assign variant = product.selected_or_first_available_variant -%}{%- assign native_count = pack_size -%}{%- if packaged -%}{%- assign native_count = 1 -%}{%- endif -%}
{%- assign native_count = native_count | at_least: 1 -%}{%- assign gross_total = variant.price | times: native_count -%}
{%- assign rate = settings.box_discount_percent | default: 5 -%}{%- assign threshold = settings.box_discount_min | default: 6 -%}{%- assign eligible = false -%}{%- if settings.box_discount_enabled != false and pack_size >= threshold and native_count >= threshold and rate > 0 -%}{%- assign eligible = true -%}{%- endif -%}
{%- assign total = gross_total -%}{%- if eligible -%}{%- assign unit_discount = variant.price | times: rate | divided_by: 100.0 | floor -%}{%- assign unit_net = variant.price | minus: unit_discount -%}{%- assign total = unit_net | times: native_count -%}{%- endif -%}
{% capture volume %}{% render 'product-fact', product: product, field: 'volume' %}{% endcapture %}{% assign volume = volume | strip %}
{% capture country %}{% render 'product-fact', product: product, field: 'country' %}{% endcapture %}{% assign country = country | strip %}
<article class="sf-wine-card vm-product-card vm-kit-card" data-kit-card><button class="zip-favorite" type="button" data-favorite data-product-key="{{ product.id }}" data-favorite-title="{{ product.title | escape }}" data-favorite-url="{{ product.url }}" aria-label="Favoritar {{ product.title | escape }}" aria-pressed="false">{% render 'icon', name: 'heart' %}</button><a class="sf-wine-visual" href="{{ product.url }}{% unless packaged %}?quantity={{ native_count }}{% endunless %}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: class: 'wine-photo', loading: 'lazy', alt: product.title }}{% endif %}{% if volume != blank %}<span class="vm-card-volume">{{ volume }}</span>{% endif %}<span class="vm-kit-badge">{% if pack_size >= 2 %}{{ pack_size }} garrafas{% elsif packaged %}Kit especial{% endif %}</span></a><div class="mi-card-strip vm-kit-band">{{ country | default: 'Caixas e kits' }}</div><div class="sf-wine-info"><div class="vm-card-details"><a class="vm-card-title" href="{{ product.url }}{% unless packaged %}?quantity={{ native_count }}{% endunless %}"><h3>{{ product.title | escape }}</h3></a><p class="vm-card-vendor">{{ product.vendor | escape }}</p><p class="vm-kit-composition">{% if packaged %}Preço do conjunto completo{% else %}{{ pack_size }} garrafas de {{ variant.price | money }}{% endif %}</p></div>
{% form 'product', product, class: 'vm-kit-form', data-shopify-add: '', data-cart-stay: '' %}<input type="hidden" name="return_to" value="{{ routes.cart_url }}"><input type="hidden" name="quantity" value="{{ native_count }}">{% unless packaged %}<input type="hidden" name="properties[_case_size]" value="{{ native_count }}">{% endunless %}<input type="hidden" name="properties[Apresentação]" value="{% if packaged %}Kit{% else %}Caixa com {{ pack_size }} garrafas{% endif %}">
<div class="vm-kit-price"><del data-kit-compare {% unless eligible %}hidden{% endunless %}>{{ gross_total | money }}</del><strong data-kit-total>{{ total | money }}</strong><small data-kit-saving>{% if eligible %}{{ rate }}% OFF · desconto automático{% else %}Valor total{% endif %}</small></div>
{% unless product.has_only_default_variant %}<label class="vm-kit-variant-label">Opção<select name="id" data-kit-variant>{% for option in product.variants %}<option value="{{ option.id }}" data-price="{{ option.price }}" data-available="{{ option.available }}" data-min="{{ option.quantity_rule.min | default: 1 }}" data-step="{{ option.quantity_rule.increment | default: 1 }}" data-max="{{ option.quantity_rule.max }}"{% if option.id == variant.id %} selected{% endif %}>{{ option.title | escape }}{% unless option.available %} — Esgotado{% endunless %}</option>{% endfor %}</select></label>{% else %}<input type="hidden" name="id" value="{{ variant.id }}">{% endunless %}
<div class="vm-kit-actions" data-kit-purchase data-case-size="{{ pack_size }}" data-native-count="{{ native_count }}" data-unit-price="{{ variant.price }}" data-discount="{% if settings.box_discount_enabled != false %}{{ rate }}{% else %}0{% endif %}" data-threshold="{{ threshold }}" data-available="{{ variant.available }}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-step="{{ variant.quantity_rule.increment | default: 1 }}" data-max="{{ variant.quantity_rule.max }}"><label>Quantidade de {% if packaged %}kits{% else %}caixas{% endif %}<div class="vm-quantity"><button type="button" data-quantity-step="-1" aria-label="Diminuir caixas">−</button><input type="number" data-kit-boxes min="1" step="1" value="1" aria-label="Quantidade de caixas"><button type="button" data-quantity-step="1" aria-label="Aumentar caixas">+</button></div></label><button type="submit" class="sf-add"{% unless variant.available %} disabled{% endunless %}>{% render 'icon', name: 'cart' %}<span data-kit-buy-label>{% if variant.available %}Adicionar · {{ total | money }}{% else %}Esgotado{% endif %}</span></button></div><p class="vm-kit-feedback" data-add-status role="status"></p>{% endform %}</div></article>
{%- endif -%}
