<section class="vm-discovery vm-container sf-catalog" data-discovery data-base-title="{% if collection.handle == 'all' %}Nossos vinhos{% else %}{{ collection.title | default: 'Nossos vinhos' | escape }}{% endif %}" data-catalog-url="{{ collection.url | default: routes.all_products_collection_url }}"><nav class="sf-breadcrumb"><a href="{{ routes.root_url }}">Início</a><span>/</span><span>Vinhos</span><span data-discovery-breadcrumb hidden></span></nav><h1 data-discovery-title>{% if collection.handle == 'all' %}Nossos vinhos{% else %}{{ collection.title | default: 'Nossos vinhos' | escape }}{% endif %}</h1><p class="vm-discovery-intro" data-discovery-intro>Encontre o vinho para o seu momento.</p>
<div class="vm-catalog-toolbar"><details class="vm-catalog-filter-panel" data-catalog-facets><summary>{% render 'icon', name: 'menu' %}<span>Filtrar vinhos</span><span data-filter-count></span></summary><form data-discovery-filters><div class="vm-facet-groups" data-facet-groups></div><div class="vm-facet-prices"><label>Preço mínimo (R$)<input name="min" type="number" min="0" step="0.01" inputmode="decimal"></label><label>Preço máximo (R$)<input name="max" type="number" min="0" step="0.01" inputmode="decimal"></label><label class="vm-only-available"><input name="disponivel" type="checkbox" value="1"> Apenas disponíveis</label></div><div class="vm-filter-actions"><button class="mi-outline" type="submit">Aplicar filtros</button><button type="button" data-discovery-clear>Limpar filtros</button></div></form></details><label class="vm-catalog-sort">Ordenar por<select data-discovery-sort><option value="manual">Destaques</option><option value="price-ascending">Menor preço</option><option value="price-descending">Maior preço</option><option value="title-ascending">Nome A–Z</option><option value="created-descending">Mais recentes</option></select></label></div>
<div class="vm-selected-filters" data-selected-filters></div><button class="vm-favorites-clear mi-outline" type="button" data-favorites-clear hidden>Limpar favoritos</button><div class="vm-pairing-filter-links" data-pairing-links hidden><a href="{{ collection.url }}?view=descobrir&amp;harmonizacao=pizzas">Pizzas</a><a href="{{ collection.url }}?view=descobrir&amp;harmonizacao=carnes-vermelhas">Carnes vermelhas</a><a href="{{ collection.url }}?view=descobrir&amp;harmonizacao=queijos">Queijos</a><a href="{{ collection.url }}?view=descobrir&amp;harmonizacao=massas">Massas</a></div>
<p class="vm-discovery-status" role="status" aria-live="polite" data-discovery-status tabindex="-1">Consultando os vinhos…</p><button type="button" data-discovery-retry hidden>Tentar novamente</button><div class="sf-catalog-grid vm-discovery-results" data-discovery-results></div><button class="mi-outline vm-discovery-more" type="button" data-discovery-more hidden>Mostrar mais vinhos</button><div class="vm-catalog-empty" data-discovery-empty hidden><p>Experimente retirar um filtro para descobrir outras opções.</p><button class="mi-outline" type="button" data-discovery-clear>Limpar filtros</button><a href="{{ routes.all_products_collection_url }}">Ver a seleção completa</a></div>
<script type="application/json" data-native-filter-map>[{% assign map_comma = '' %}{% for filter in collections.all.filters %}{% for value in filter.values %}{{ map_comma }}{"parameter":{{ value.param_name | json }},"value":{{ value.value | json }},"label":{{ value.label | json }}}{% assign map_comma = ',' %}{% endfor %}{% endfor %}]</script>
{% paginate collection.products by 48 %}<div data-discovery-batch data-next="{{ paginate.next.url }}" hidden>{% for product in collection.products %}{% capture origin %}{% render 'product-fact', product: product, field: 'country' %}{% endcapture %}{% capture pairing %}{% render 'product-fact', product: product, field: 'pairing' %}{% endcapture %}{% capture grapes %}{% render 'product-fact', product: product, field: 'grape' %}{% endcapture %}{% capture search_profile %}{% render 'product-fact', product: product, field: 'palate' %}{% render 'product-fact', product: product, field: 'sweetness' %}{% render 'product-fact', product: product, field: 'alcohol' %}{% endcapture %}{% capture types %}{% render 'product-fact', product: product, field: 'type' %}{% endcapture %}{% assign indexed_variant = product.selected_or_first_available_variant %}{% for option in product.variants %}{% if option.available and option.price < indexed_variant.price %}{% assign indexed_variant = option %}{% endif %}{% endfor %}<template data-discovery-card data-profile="{{ search_profile | strip | replace: '&amp;', '&' | escape }}" data-id="{{ product.id }}" data-pairing="{{ pairing | strip | escape }}" data-country="{{ origin | strip | escape }}" data-grapes="{{ grapes | strip | escape }}" data-types="{{ types | strip | escape }}" data-vendor="{{ product.vendor | escape }}" data-title="{{ product.title | escape }}" data-price="{{ indexed_variant.price | default: product.price }}" data-created="{{ product.created_at | date: '%s' }}" data-available="{{ product.available }}">{% render 'product-card', product: product %}</template>{% capture kit_card %}{% render 'kit-card', product: product %}{% endcapture %}{% assign kit_card = kit_card | strip %}{% if kit_card != blank %}<template data-discovery-kit data-id="{{ product.id }}">{{ kit_card }}</template>{% endif %}{% endfor %}</div><noscript><p>Ative o JavaScript para combinar filtros. Você pode abrir os vinhos abaixo.</p><div class="sf-catalog-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}</div>{{ paginate | default_pagination }}</noscript>{% endpaginate %}
</section>
